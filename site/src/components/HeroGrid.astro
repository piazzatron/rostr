<!-- The hero's background: a bench of squares with a wave sweeping through it, and a few drafted agents pulsing -->
<div class="hero-grid" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  /* Full-bleed behind the hero and up behind the nav, fading out before the terminal */
  .hero-grid {
    position: absolute;
    z-index: -1;
    top: -120px;
    bottom: 0;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    overflow: hidden;
    pointer-events: none;
    mask-image:
      linear-gradient(to bottom, #000 45%, transparent 80%),
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
  }

  /* On phones the grid ends where the call to action starts (the script sets its bottom), fading out through the intro,
     and the side fades are narrow, since there's no room beside the text */
  @media (max-width: 640px) {
    .hero-grid {
      mask-image:
        linear-gradient(to bottom, #000 50%, transparent 100%),
        linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    }
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    animation: grid-in 1.2s ease both;
  }

  @keyframes grid-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    canvas {
      animation: none;
    }
  }

</style>

<script>
  const PITCH = 22; // distance between squares
  const SIZE = 4; // an idle square's side
  const RELEASE_MS = 300; // a released square fades back to the bench over this long
  const HOVER_RADIUS = 70;
  const WAVE_SWEEP_MS = 3800; // a soft diagonal band sweeps across the bench this fast
  const WAVE_GAP_MS = 2200; // then waits this long before the next sweep
  const WAVE_WIDTH = 140; // half the band's width
  const WAVE_SLANT = 0.6; // how far the band leans: x moves this much per unit of y

  type Rect = { left: number; top: number; right: number; bottom: number };
  type Agent = { x: number; y: number; start: number; end: number; period: number };

  const grid = document.querySelector<HTMLElement>(".hero-grid");
  const hero = grid?.parentElement;
  const canvas = grid?.querySelector("canvas");
  const ctx = canvas?.getContext("2d");
  if (grid && hero && canvas && ctx) {
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const darkMode = matchMedia("(prefers-color-scheme: dark)");
    const phone = matchMedia("(max-width: 640px)");

    const bench = document.createElement("canvas"); // the idle squares, drawn once per resize or theme change
    const agents = new Map<number, Agent>(); // drafted squares by cell index
    let width = 0;
    let height = 0;
    let top = 0; // how much of the grid is above the top of the page
    let columns = 0;
    let rows = 0;
    let originX = 0;
    let originY = 0;
    let behindText = new Uint8Array(0); // per cell: 1 behind the text, where the wave stays faint
    let textRects: Rect[] = []; // the hero's text, which drafted squares stay clear of
    let colors = { accent: "", muted: "" };
    let pointer: { x: number; y: number } | undefined;
    let nextDraft = 0;
    let visible = true;
    let frame = 0;
    let waveStart = 0; // when the first sweep began, on load

    const random = (min: number, max: number) => min + Math.random() * (max - min);
    const overlaps = (a: Rect, b: Rect) => a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom;
    const cellCenter = (index: number) => ({
      x: originX + (index % columns) * PITCH,
      y: originY + Math.floor(index / columns) * PITCH,
    });

    function layout() {
      // On phones the hero is one tall column, so the grid stops at the call to action instead of running down behind
      // the terminal. On wider screens it fills the hero.
      const callToAction = hero!.querySelector<HTMLElement>(".cta-title");
      grid!.style.bottom =
        phone.matches && callToAction ? `${hero!.clientHeight - callToAction.offsetTop}px` : "";

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const box = grid!.getBoundingClientRect();
      width = box.width;
      height = box.height;
      top = Math.max(0, -(box.top + scrollY));
      for (const target of [canvas!, bench]) {
        target.width = Math.round(width * dpr);
        target.height = Math.round(height * dpr);
      }
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      columns = Math.floor(width / PITCH);
      rows = Math.floor(height / PITCH);
      originX = (width - (columns - 1) * PITCH) / 2;
      originY = (height - (rows - 1) * PITCH) / 2;

      // The hero's text by layout position, which ignores its fade-up on load; the nav doesn't move, so it's measured
      const pad = 10;
      const nav = document.querySelector(".nav")?.getBoundingClientRect();
      const blocks = [...hero!.children]
        .filter((child): child is HTMLElement => child instanceof HTMLElement && child !== grid)
        .map((child) => ({
          left: child.offsetLeft - grid!.offsetLeft,
          top: child.offsetTop - grid!.offsetTop,
          right: child.offsetLeft - grid!.offsetLeft + child.offsetWidth,
          bottom: child.offsetTop - grid!.offsetTop + child.offsetHeight,
        }));
      if (nav) {
        blocks.push({
          left: nav.left - box.left,
          top: nav.top - box.top,
          right: nav.right - box.left,
          bottom: nav.bottom - box.top,
        });
      }
      textRects = blocks
        .filter((rect) => rect.right > rect.left)
        .map((rect) => ({ left: rect.left - pad, top: rect.top - pad, right: rect.right + pad, bottom: rect.bottom + pad }));

      // Drafted squares from the old layout don't line up anymore
      agents.clear();
      drawBench();
    }

    function drawBench() {
      const style = getComputedStyle(document.documentElement);
      colors = { accent: style.getPropertyValue("--accent").trim(), muted: style.getPropertyValue("--muted").trim() };
      const benchCtx = bench.getContext("2d")!;
      benchCtx.setTransform(bench.width / width, 0, 0, bench.height / height, 0, 0);
      benchCtx.clearRect(0, 0, width, height);
      benchCtx.fillStyle = colors.muted;
      const alpha = darkMode.matches ? 0.24 : 0.17;
      behindText = new Uint8Array(columns * rows);
      for (let index = 0; index < columns * rows; index++) {
        const { x, y } = cellCenter(index);
        // Fainter behind the text, so it reads cleanly
        behindText[index] = textRects.some((rect) => x > rect.left && x < rect.right && y > rect.top && y < rect.bottom) ? 1 : 0;
        benchCtx.globalAlpha = behindText[index] ? alpha * 0.35 : alpha;
        benchCtx.beginPath();
        benchCtx.roundRect(x - SIZE / 2, y - SIZE / 2, SIZE, SIZE, 1);
        benchCtx.fill();
      }
    }

    // Draft a random free square away from the text, for a few pulses
    function draft(now: number) {
      for (let attempt = 0; attempt < 20; attempt++) {
        const index = Math.floor(Math.random() * columns * rows);
        if (agents.has(index)) continue;
        const { x, y } = cellCenter(index);
        if (y > height * 0.7) continue; // faded out by the mask
        if (y < top + 16) continue; // above the top of the page
        const square = { left: x - 6, top: y - 6, right: x + 6, bottom: y + 6 };
        if (textRects.some((rect) => overlaps(rect, square))) continue;

        const period = random(1600, 2600);
        agents.set(index, { x, y, period, start: now, end: now + period * Math.round(random(3, 6)) });
        return;
      }
    }


    // The wave: a soft gray band that sweeps diagonally across the bench, then rests before the next sweep
    // How far the band's middle travels in a sweep, measured along x + y * WAVE_SLANT
    const waveSpan = () => width + height * WAVE_SLANT + 2 * WAVE_WIDTH;

    function drawWave(now: number) {
      const elapsed = now - waveStart;
      const phase = (elapsed % (WAVE_SWEEP_MS + WAVE_GAP_MS)) / WAVE_SWEEP_MS;
      if (elapsed < 0 || phase > 1) return;
      const span = waveSpan();
      const front = -WAVE_WIDTH + phase * span; // where the band's middle is, measured along x + y * WAVE_SLANT
      ctx!.fillStyle = colors.muted;
      const peak = darkMode.matches ? 0.45 : 0.4;
      for (let row = 0; row < rows; row++) {
        const y = originY + row * PITCH;
        const middle = front - y * WAVE_SLANT;
        const minColumn = Math.max(0, Math.ceil((middle - WAVE_WIDTH - originX) / PITCH));
        const maxColumn = Math.min(columns - 1, Math.floor((middle + WAVE_WIDTH - originX) / PITCH));
        for (let column = minColumn; column <= maxColumn; column++) {
          const x = originX + column * PITCH;
          const lift = 0.5 + 0.5 * Math.cos((Math.PI * (x - middle)) / WAVE_WIDTH);
          const size = SIZE + lift * 1.5;
          ctx!.globalAlpha = lift * peak * (behindText[row * columns + column] ? 0.3 : 1);
          ctx!.beginPath();
          ctx!.roundRect(x - size / 2, y - size / 2, size, size, 1.5);
          ctx!.fill();
        }
      }
    }

    function draw(now: number) {
      ctx!.clearRect(0, 0, width, height);
      ctx!.drawImage(bench, 0, 0, width, height);
      if (!reducedMotion.matches) drawWave(now);

      // Squares near the pointer brighten, like the bench noticing you
      if (pointer) {
        ctx!.fillStyle = colors.muted;
        const { x: px, y: py } = pointer;
        const minColumn = Math.max(0, Math.floor((px - originX - HOVER_RADIUS) / PITCH));
        const maxColumn = Math.min(columns - 1, Math.ceil((px - originX + HOVER_RADIUS) / PITCH));
        const minRow = Math.max(0, Math.floor((py - originY - HOVER_RADIUS) / PITCH));
        const maxRow = Math.min(rows - 1, Math.ceil((py - originY + HOVER_RADIUS) / PITCH));
        for (let row = minRow; row <= maxRow; row++) {
          for (let column = minColumn; column <= maxColumn; column++) {
            const x = originX + column * PITCH;
            const y = originY + row * PITCH;
            const closeness = 1 - Math.hypot(x - px, y - py) / HOVER_RADIUS;
            if (closeness <= 0) continue;
            const size = SIZE + closeness;
            ctx!.globalAlpha = closeness * 0.3;
            ctx!.beginPath();
            ctx!.roundRect(x - size / 2, y - size / 2, size, size, 1.5);
            ctx!.fill();
          }
        }
      }

      ctx!.fillStyle = colors.accent;
      for (const [index, agent] of agents) {
        const age = now - agent.start;
        const left = agent.end - now;
        if (left <= -RELEASE_MS) {
          agents.delete(index);
          continue;
        }
        if (age < 0) continue; // waiting for the first sweep to reach it

        // Each pulse eases on and decays to a faint glow until the next; a released square fades out quickly
        const beat = (age % agent.period) / agent.period;
        const rise = Math.min(beat / 0.15, 1);
        const flash = beat < 0.15 ? rise * rise * (3 - 2 * rise) : Math.exp(-(beat - 0.15) * 4);
        const strength = (0.25 + 0.75 * flash) * (left > 0 ? 1 : 1 + left / RELEASE_MS);
        const size = SIZE + 1.5 * strength;

        ctx!.globalAlpha = strength * 0.08;
        ctx!.beginPath();
        ctx!.roundRect(agent.x - size, agent.y - size, size * 2, size * 2, size / 2);
        ctx!.fill();
        ctx!.globalAlpha = strength * 0.6;
        ctx!.beginPath();
        ctx!.roundRect(agent.x - size / 2, agent.y - size / 2, size, size, 1.5);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    function tick(now: number) {
      frame = 0;
      if (!visible) return;
      const target = draftTarget();
      if (now >= nextDraft && agents.size < target) {
        draft(now);
        nextDraft = now + random(700, 1800);
      }
      draw(now);
      frame = requestAnimationFrame(tick);
    }

    // How many squares are drafted at once: a few, scaled a little with the screen
    function draftTarget() {
      return Math.min(10, Math.max(4, Math.round(columns * rows * 0.0035)));
    }

    // Start with the usual number of drafted squares, rather than filling the grid up. On load, the first sweep calls
    // them up: each starts pulsing as the wave reaches it, and the regular drafting begins once the sweep is done.
    function start() {
      cancelAnimationFrame(frame);
      layout();
      const now = performance.now();
      waveStart ||= now + 200;
      for (let i = 0; i < 40 && agents.size < draftTarget(); i++) draft(now - random(0, 2000));
      nextDraft = now + random(700, 1800);
      if (!reducedMotion.matches && now < waveStart + WAVE_SWEEP_MS) {
        for (const agent of agents.values()) {
          const reached = waveStart + ((agent.x + agent.y * WAVE_SLANT + WAVE_WIDTH) / waveSpan()) * WAVE_SWEEP_MS;
          agent.end += Math.max(reached, now) - agent.start;
          agent.start = Math.max(reached, now);
        }
        nextDraft = waveStart + WAVE_SWEEP_MS;
      }
      if (reducedMotion.matches) {
        // One still frame
        for (const agent of agents.values()) agent.end = Infinity;
        draw(now);
        return;
      }
      frame = requestAnimationFrame(tick);
    }

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 100);
    }).observe(hero);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame && !reducedMotion.matches) frame = requestAnimationFrame(tick);
    }).observe(grid);
    darkMode.addEventListener("change", start);
    reducedMotion.addEventListener("change", start);
    document.fonts?.ready.then(start);

    if (!reducedMotion.matches) {
      window.addEventListener("pointermove", (event) => {
        const box = grid.getBoundingClientRect();
        const x = event.clientX - box.left;
        const y = event.clientY - box.top;
        pointer = x >= 0 && y >= 0 && x <= box.width && y <= box.height ? { x, y } : undefined;
      });
      document.documentElement.addEventListener("pointerleave", () => (pointer = undefined));
    }

    start();
  }
</script>
