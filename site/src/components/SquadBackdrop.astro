---
// Squad up's background: little squads get drafted in the empty space around the rosters. Each member pops in as a
// name chip, turns into a multiplayer cursor with its name on it, and the squad's cursors gather to work together,
// clicking around and picking up tasks, before heading back to the bench.
interface Props {
  rosters: string[][]; // each roster's members, like "🧙 Gandalf"
  tasks: string[];
}
const { rosters, tasks } = Astro.props;
---

<div class="squad-backdrop" aria-hidden="true" data-rosters={JSON.stringify(rosters)} data-tasks={JSON.stringify(tasks)}>
</div>

<style>
  /* Full-bleed behind the section, fading out at the sides */
  .squad-backdrop {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  /* Everything moves by translate from the top left, so the script only animates translate */
  .squad-backdrop :global(.squad-chip),
  .squad-backdrop :global(.squad-cursor),
  .squad-backdrop :global(.squad-ripple) {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* A drafted member's name, and later its cursor's label: both sit just below and right of the point, so the chip
     turns into the label in place */
  .squad-backdrop :global(.squad-chip),
  .squad-backdrop :global(.squad-label) {
    margin: 15px 0 0 11px;
    padding: 3px 9px 3px 8px;
    border-radius: 4px 10px 10px 10px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transform-origin: top left;
  }

  .squad-backdrop :global(.squad-chip) {
    border: 1px solid color-mix(in srgb, var(--squad-color) 45%, var(--border));
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.25);
  }

  .squad-backdrop :global(.squad-label) {
    position: absolute;
    top: 0;
    left: 0;
    border: 1px solid transparent;
    background: var(--squad-color);
    color: white;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.12),
      0 6px 14px -6px color-mix(in srgb, var(--squad-color) 70%, transparent);
  }

  .squad-backdrop :global(.squad-cursor svg) {
    display: block;
    width: 15px;
    height: 17px;
    margin: -1px 0 0 -1px; /* puts the arrow's tip on the point */
    transform-origin: top left;
    filter: drop-shadow(0 1.5px 2px rgb(0 0 0 / 0.22));
  }

  /* The task follows the name after a thin divider, like a session title */
  .squad-backdrop :global(.squad-task) {
    margin-left: 6px;
    padding-left: 6px;
    border-left: 1px solid rgb(255 255 255 / 0.35);
    font-weight: 500;
  }

  .squad-backdrop :global(.squad-ripple) {
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--squad-color) 22%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .squad-backdrop {
      display: none;
    }
  }
</style>

<script>
  const MAX_SQUADS = 4; // on screen at once
  const SQUAD_GAP_MS = [1500, 3000]; // between one squad being drafted and the next
  const LANE = { x: 90, y: 22 }; // how far a member strays from its own spot, mostly sideways, like working along a line
  const LABEL_BOX = { width: 240, height: 44 }; // room a cursor needs below and right of its tip, for its label
  // Squad colors, one per squad; the first is the site's accent
  const COLORS = ["var(--accent)", "#7c5cff", "#12a37f", "#3b82f6", "#e5508a"];
  const CURSOR_SVG =
    '<svg viewBox="0 0 15 17"><path d="M1.5 1.5v12.2c0 .5.6.8 1 .4l2.9-2.9 2.1 4.4c.2.4.6.5 1 .3l1.3-.6c.4-.2.5-.6.3-1L8 10.1h4.1c.5 0 .8-.6.4-1L2.5 1.1c-.4-.3-1-.1-1 .4z" fill="var(--squad-color)" stroke="white" stroke-width="1.5" stroke-linejoin="round"/></svg>';

  type Point = { x: number; y: number };
  type Rect = { left: number; top: number; right: number; bottom: number };

  const backdrop = document.querySelector<HTMLElement>(".squad-backdrop");
  const section = backdrop?.parentElement;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  if (backdrop && section && !reducedMotion.matches) {
    const rosters: string[][] = JSON.parse(backdrop.dataset.rosters ?? "[]");
    const tasks: string[] = JSON.parse(backdrop.dataset.tasks ?? "[]");
    const meetingPoints = new Set<Point>(); // where the squads on screen are working, so new ones keep clear
    let colorIndex = 0;
    let visible = false;
    let timer = 0;

    const random = (min: number, max: number) => min + Math.random() * (max - min);
    const pick = <T,>(items: T[]) => items[Math.floor(Math.random() * items.length)];
    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const at = ({ x, y }: Point) => `${x.toFixed(1)}px ${y.toFixed(1)}px`;

    // The section's content, relative to the backdrop: each roster tile, and the text of each block rather than its
    // full width, so the space beside a short heading or link counts as free
    function contentRects(): Rect[] {
      const origin = backdrop!.getBoundingClientRect();
      const pad = 14;
      const boxes: DOMRect[] = [];
      for (const child of section!.children) {
        if (child === backdrop) continue;
        if (child.matches("ul")) boxes.push(...[...child.children].map((tile) => tile.getBoundingClientRect()));
        else if (child.matches("h2, p")) {
          const range = document.createRange();
          range.selectNodeContents(child);
          boxes.push(range.getBoundingClientRect());
        } else boxes.push(child.getBoundingClientRect());
      }
      return boxes
        .filter((box) => box.width > 0)
        .map((box) => ({
          left: box.left - origin.left - pad,
          top: box.top - origin.top - pad,
          right: box.right - origin.left + pad,
          bottom: box.bottom - origin.top + pad,
        }));
    }

    // Whether a cursor at this point, and its label, would be clear of the content and inside the backdrop
    function isFree({ x, y }: Point, content: Rect[]) {
      const box = { left: x - 12, top: y - 12, right: x + LABEL_BOX.width, bottom: y + LABEL_BOX.height };
      const { width, height } = backdrop!.getBoundingClientRect();
      if (box.left < width * 0.03 || box.right > width * 0.99 || box.top < 8 || box.bottom > height - 8) return false;
      return !content.some((rect) => box.left < rect.right && rect.left < box.right && box.top < rect.bottom && rect.top < box.bottom);
    }

    // A free point within the given reach of a center (sideways and up or down), or anywhere when there's no center,
    // whose label keeps the given gap from its teammates'
    function freePoint(
      content: Rect[],
      center?: Point,
      reach = { x: 0, y: 0 },
      teammates: Point[] = [],
      gap = { x: LABEL_BOX.width, y: 36 },
    ): Point | undefined {
      const { width, height } = backdrop!.getBoundingClientRect();
      for (let attempt = 0; attempt < 60; attempt++) {
        const point = center
          ? { x: center.x + random(-reach.x, reach.x), y: center.y + random(-reach.y, reach.y) }
          : { x: random(0, width), y: random(0, height) };
        if (!isFree(point, content)) continue;
        if (teammates.some((other) => Math.abs(other.x - point.x) < gap.x && Math.abs(other.y - point.y) < gap.y)) continue;
        if (!center && [...meetingPoints].some((other) => Math.hypot(other.x - point.x, other.y - point.y) < 220)) continue;
        return point;
      }
    }

    function make(className: string, color: string, html = "") {
      const element = document.createElement("span");
      element.className = className;
      element.style.setProperty("--squad-color", color);
      element.innerHTML = html;
      backdrop!.append(element);
      return element;
    }

    // Cursors move like a hand on a mouse. A guide point travels each move along a gentle curve with a minimum-jerk
    // profile (easing in and out the way people do), the cursor follows the guide on a loose spring, so it trails a
    // little and settles with a slight overshoot, and it drifts a few pixels while it rests. One frame loop moves them
    // all.
    type Cursor = {
      element: HTMLElement;
      position: Point;
      velocity: Point;
      guide: Point;
      path?: { from: Point; bend: Point; to: Point; start: number; duration: number };
      drift: number[]; // per-cursor phases for the resting drift
    };
    const SPRING = { stiffness: 220, damping: 22 }; // a bit under critical damping (2√220 ≈ 30), for a small overshoot
    const cursors = new Set<Cursor>();
    let frame = 0;
    let lastFrame = 0;

    function step(now: number) {
      const dt = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      for (const cursor of cursors) {
        const { path } = cursor;
        if (path) {
          const t = Math.min(1, (now - path.start) / path.duration);
          const e = t * t * t * (10 - 15 * t + 6 * t * t);
          // A quadratic curve from where it was through the bend to where it's going
          const a = (1 - e) * (1 - e);
          const b = 2 * (1 - e) * e;
          const c = e * e;
          cursor.guide = {
            x: a * path.from.x + b * path.bend.x + c * path.to.x,
            y: a * path.from.y + b * path.bend.y + c * path.to.y,
          };
          if (t >= 1) cursor.path = undefined;
        }
        // The spring, in small steps so it stays stable
        for (let left = dt; left > 0; left -= 1 / 240) {
          const h = Math.min(left, 1 / 240);
          for (const axis of ["x", "y"] as const) {
            const force = SPRING.stiffness * (cursor.guide[axis] - cursor.position[axis]) - SPRING.damping * cursor.velocity[axis];
            cursor.velocity[axis] += force * h;
            cursor.position[axis] += cursor.velocity[axis] * h;
          }
        }
        const seconds = now / 1000;
        const [p1, p2, p3, p4] = cursor.drift;
        const drift = {
          x: 2.5 * Math.sin(seconds * 0.9 + p1) + 1.2 * Math.sin(seconds * 2.1 + p2),
          y: 2 * Math.sin(seconds * 0.7 + p3) + 1 * Math.sin(seconds * 1.9 + p4),
        };
        cursor.element.style.translate = at({ x: cursor.position.x + drift.x, y: cursor.position.y + drift.y });
      }
      frame = cursors.size ? requestAnimationFrame(step) : 0;
    }

    function addCursor(element: HTMLElement, position: Point): Cursor {
      const cursor = {
        element,
        position: { ...position },
        velocity: { x: 0, y: 0 },
        guide: { ...position },
        drift: [0, 0, 0, 0].map(() => random(0, Math.PI * 2)),
      };
      cursors.add(cursor);
      if (!frame) {
        lastFrame = performance.now();
        frame = requestAnimationFrame(step);
      }
      return cursor;
    }

    // Sends a cursor to a point, bowing the path a little to one side; longer moves take longer, but not
    // proportionally, as with a real hand. Resolves once it has about arrived.
    function moveTo(cursor: Cursor, to: Point) {
      const from = { ...cursor.guide };
      const distance = Math.hypot(to.x - from.x, to.y - from.y);
      const bow = random(0.12, 0.28) * (Math.random() < 0.5 ? -1 : 1);
      const bend = {
        x: (from.x + to.x) / 2 - (to.y - from.y) * bow,
        y: (from.y + to.y) / 2 + (to.x - from.x) * bow,
      };
      const duration = 380 + 160 * Math.log2(1 + distance / 12);
      cursor.path = { from, bend, to, start: performance.now(), duration };
      return sleep(duration + 120);
    }

    // A click: the cursor dips and a ring spreads from its tip
    async function click(cursor: Cursor, color: string) {
      const ripple = make("squad-ripple", color);
      ripple.style.translate = at(cursor.position);
      cursor.element.firstElementChild!.animate([{ scale: 1 }, { scale: 0.85 }, { scale: 1 }], {
        duration: 260,
        easing: "ease-out",
      });
      await ripple.animate([{ scale: 0.2, opacity: 1 }, { scale: 1.6, opacity: 0 }], {
        duration: 700,
        easing: "ease-out",
      }).finished;
      ripple.remove();
    }

    // One member: drafted as a chip, then a cursor that works around the meeting point and picks up a task
    async function member(name: string, color: string, meeting: Point, content: Rect[], spots: Map<string, Point>, delay: number) {
      await sleep(delay);
      const teammates = () => [...spots].filter(([other]) => other !== name).map(([, spot]) => spot);
      // A spot of its own near the squad's, a lane away from teammates', so working along it never takes its label
      // across theirs
      const start = freePoint(content, meeting, { x: 170, y: 110 }, teammates(), { x: LABEL_BOX.width + 2 * LANE.x, y: 70 });
      if (!start) return;
      spots.set(name, start);

      const chip = make("squad-chip", color);
      chip.textContent = name;
      chip.style.translate = at(start);
      // It rises into place as it's drafted
      await chip.animate([{ opacity: 0, translate: at({ x: start.x, y: start.y + 6 }) }, { opacity: 1, translate: at(start) }], {
        duration: 500,
        easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
      }).finished;
      await sleep(900);

      // Put to work: the chip takes on the squad's color as its label, and the cursor's arrow appears at its corner
      const cursor = make("squad-cursor", color, CURSOR_SVG);
      const label = document.createElement("span");
      label.className = "squad-label";
      label.textContent = name;
      cursor.append(label);
      const hand = addCursor(cursor, start);
      const appear = { duration: 350, easing: "ease-out" };
      label.animate([{ opacity: 0 }, { opacity: 1 }], appear);
      cursor.firstElementChild!.animate([{ scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1 }], appear);
      await chip.animate([{ opacity: 1 }, { opacity: 0 }], { ...appear, fill: "forwards" }).finished;
      chip.remove();

      await sleep(random(200, 500));
      const stops = Math.round(random(3, 6));
      for (let stop = 0; stop < stops; stop++) {
        const next = freePoint(content, start, LANE, teammates(), { x: 0, y: 0 }) ?? start;
        await moveTo(hand, next);
        if (Math.random() < 0.4) await click(hand, color);
        // At the first stop the member picks up its task, which shows in its label like a session title
        if (stop === 0) {
          const task = document.createElement("span");
          task.className = "squad-task";
          task.textContent = pick(tasks);
          label.append(task);
          task.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300 });
        }
        await sleep(random(500, 1600));
      }

      // Back to the bench
      await cursor.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 600, easing: "ease-in", fill: "forwards" })
        .finished;
      cursors.delete(hand);
      cursor.remove();
      spots.delete(name);
    }

    // A squad: two to four members of one roster, drafted one after another, working around a shared spot
    async function squad() {
      const content = contentRects();
      const meeting = freePoint(content);
      if (!meeting) return;
      meetingPoints.add(meeting);
      const color = COLORS[colorIndex++ % COLORS.length];
      const members = [...pick(rosters)].sort(() => Math.random() - 0.5).slice(0, pick([2, 2, 3, 3, 4]));
      const spots = new Map<string, Point>(); // where each member is, or is headed
      await Promise.all(members.map((name, i) => member(name, color, meeting, content, spots, i * random(600, 1000))));
      meetingPoints.delete(meeting);
    }

    // Drafts a squad every few seconds while the section is on screen
    function schedule() {
      clearTimeout(timer);
      if (!visible) return;
      if (meetingPoints.size < MAX_SQUADS) squad();
      timer = window.setTimeout(schedule, random(SQUAD_GAP_MS[0], SQUAD_GAP_MS[1]));
    }

    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (visible && !wasVisible) schedule();
    }).observe(backdrop);
  }
</script>
