---
import Layout from "../layouts/Layout.astro";
import ClaudeIcon from "../assets/claude.svg";
import { GITHUB_URL, SUBMIT_ROSTER_URL } from "../consts";
import { PRESET_ROSTERS } from "../data/rosters";

const SETUP_PROMPT = "Set up rostr for me by following the instructions at https://getrostr.sh";

const ROSTER_MEMBERS = [
  { emoji: "🧙", name: "Gandalf", task: "Fix auth redirect loop", where: "rostr/api", since: "12m" },
  { emoji: "🌱", name: "Samwise", task: "Migrate billing to Stripe v3", where: "smart-notes", since: "1h" },
  { emoji: "💍", name: "Frodo", task: "Flaky e2e tests on CI", where: "rostr/site", since: "3m" },
  { emoji: "👑", name: "Aragorn", task: "Postgres index audit", where: "cloud", since: "40m" },
];

const IDLE_MEMBERS = ["Legolas", "Gimli", "Boromir", "Pippin", "Merry", "Balrog"];

const AUTOMATIC_COMMANDS = [
  { command: "rostr draft", description: "Runs when a session starts. Drafts the next free agent, A team first, and tells it who it is." },
  { command: "rostr assign", description: "Sets each agent's task from your first prompt, and updates it if the work changes." },
  { command: "rostr release", description: "Runs when a session ends, or when your agent finishes its work." },
];

const CONTROL_COMMANDS = [
  { command: "rostr list", description: "See who's working on what, and who's idle." },
  { command: "rostr presets", description: "See all the pre-built rosters you can start from." },
  { command: "rostr use <roster>", description: "Give a project its own roster. Projects without one use your default." },
  { command: "rostr edit", description: "Add, remove, or rename members, pick your A team, or turn emoji on and off." },
  { command: "rostr recast", description: "Swap a roster's cast for a new theme, or a random one, without touching your setup." },
  { command: "rostr transfer", description: "Move your whole setup to the cloud, so cloud sessions can draft too." },
  { command: "rostr submit <roster>", description: "Made a great roster? Submit it to be considered as a pre-built one." },
  { command: "rostr disband <roster>", description: "Delete a roster." },
];

// The "Build on it" dashboard example uses the Smash Bros roster
const DASHBOARD_ROSTER = PRESET_ROSTERS.find((roster) => roster.id === "smash-bros")!;
const DASHBOARD_MEMBERS = [
  { emoji: "🍄", name: "Mario", task: "Ship the onboarding redesign", where: "acme/web", since: "25m" },
  { emoji: "🗡️", name: "Link", task: "Fix flaky checkout test", where: "acme/api", since: "8m" },
  { emoji: "⭐", name: "Kirby", task: "Upgrade the image pipeline", where: "acme/api", since: "2h" },
  { emoji: "🚀", name: "Samus", task: "Add rate limiting to the API", where: "cloud", since: "50m" },
];
const DASHBOARD_IDLE_CHIPS = [...DASHBOARD_ROSTER.aTeam, ...DASHBOARD_ROSTER.bTeam].filter(
  (member) => !DASHBOARD_MEMBERS.some((working) => member.endsWith(` ${working.name}`)),
);

// Notification titles for the before/after comparison in the "poor human brain" section
const NOTIFICATIONS_WITHOUT_ROSTR = ["New session"];
const NOTIFICATIONS_WITH_ROSTR = ["📚 Hermione · Speed up the search API"];

const LIST_JSON_EXAMPLE = `{
  "roster": "work",
  "drafted": [
    {
      "name": "Gandalf",
      "emoji": "🧙",
      "team": "A",
      "task": "Fix auth redirect loop",
      "repo": "piazzatron/rostr",
      "draftedAt": "2026-10-19T03:12:00Z"
    }
  ],
  "idle": [
    {
      "name": "Legolas",
      "emoji": "🏹",
      "team": "A"
    }
  ]
}`;

---

<Layout
  title="rostr: give your agents names"
  description="rostr gives each of your coding agents a name, so you can remember who's doing what. Works with Claude Code and Codex."
>
    <!-- Hero -->
    <section class="hero">
      <h1>Give your agents names. Remember who's doing what.</h1>
      <p class="lede lede-example">🧙 Gandalf's on the auth bug. 🌱 Samwise is on billing.</p>
      <p class="lede">
        rostr drafts a name for every coding agent session you start, from a roster you pick, so you never have to dig
        through five tabs called "New session" again.
      </p>
      <p class="cta-title">Get started: paste this into your agent</p>
      <div class="cta">
        <button class="copy copy-hero" data-copy={SETUP_PROMPT}>
          <span class="copy-text">“{SETUP_PROMPT}”</span>
          <span class="copy-label">Copy</span>
        </button>
        <a class="button-secondary" href={GITHUB_URL}>View on GitHub</a>
      </div>
      <a class="cta-alt" href="#install">or install with Homebrew ↓</a>
      <p class="works-with">
        Works out of the box with <strong>Claude Code</strong> and <strong>Codex</strong>, in local and cloud sessions.
        <br />
        Runs on <strong>macOS</strong>, <strong>Linux</strong>, and <strong>Windows</strong>.
      </p>

      <div class="terminal" aria-label="Example output of rostr list">
        <div class="terminal-bar"><span></span><span></span><span></span></div>
        <pre><span class="prompt">$</span> rostr list
<span class="dim">fellowship · A team: 4 of 6 drafted</span>
{ROSTER_MEMBERS.map((member) => `\n${member.emoji} ${member.name.padEnd(9)} ${member.task.padEnd(30)} ${member.where.padEnd(12)} ${member.since}`).join("")}

<span class="dim">idle: {IDLE_MEMBERS.join(", ")}</span>
</pre>
      </div>
    </section>

    <!-- Why -->
    <section class="section narrow">
      <h2>Give your poor human brain a rest</h2>
      <p>
        Running five agents at once is easy. Remembering what each one is doing is not. Every workstream you have in
        flight is something you're holding in your head, and anonymous sessions make it harder: "Untitled 4" and "Fix
        bug" tell you nothing when you come back an hour later.
      </p>
      <p>
        A good engineering manager doesn't keep a mental list of tickets. They know their team, and they know who's on
        what. Ask who's handling the billing migration and the answer is instant. rostr gives your agents that kind of
        identity, so you're checking in with Samwise about billing instead of hunting for the right terminal.
      </p>
      <p>
        It works outside the terminal too. When an agent reaches out to you on Slack, in a PR comment, or anywhere else,
        it signs with its name: "Gandalf here, the auth fix is ready for review." You know exactly who's asking, and
        getting back to that session is as easy as finding Gandalf in your session list.
      </p>
      <p>
        Notifications get the same upgrade. No more getting lost in notification soup, where every alert says
        "Claude is waiting for your input" and you have to click through each one to find out which chat it means. Each
        one tells you who's asking, so you know exactly which chat to open.
      </p>
      <div class="notification-compare">
        {[
          { label: "Without rostr", titles: NOTIFICATIONS_WITHOUT_ROSTR },
          { label: "With rostr", titles: NOTIFICATIONS_WITH_ROSTR },
        ].map((column) => (
          <div class="notification-column">
            <span class="compare-label">{column.label}</span>
            {column.titles.map((title) => (
              <div class="notification">
                <span class="notification-icon"><ClaudeIcon aria-hidden="true" /></span>
                <div class="notification-text">
                  <div class="notification-top">
                    <strong>{title}</strong>
                    <span>now</span>
                  </div>
                  <p>Claude is waiting for your input</p>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
      <p>
        Names from stories you already know work best. Samwise comes with a personality attached, so "Samwise is on
        billing" sticks in a way that "session 3" never will.
      </p>
    </section>

    <!-- How it works -->
    <section class="section" id="how-it-works">
      <h2>How it works</h2>
      <p class="section-lede">rostr is a small CLI plus a skill that teaches your agent how to use it.</p>
      <ol class="steps">
        <li>
          <h3>Pick a roster</h3>
          <p>Run <code>rostr create</code> and choose one of the pre-built rosters, or bring your own list of names.</p>
        </li>
        <li>
          <h3>Every session gets drafted</h3>
          <p>
            When a session starts, a hook drafts the next available name and tells the agent who it is. The name goes
            at the front of the session title: <code>🧙 Gandalf · Fix auth redirect loop</code>.
          </p>
        </li>
        <li>
          <h3>Agents go back to the bench</h3>
          <p>
            The rostr skill has your agent release its name when the work is done, so the same familiar faces keep
            coming back and your roster stays small.
          </p>
        </li>
      </ol>

      <!-- TODO: screenshot of named sessions in the Claude Code / Codex sidebar -->
      <figure class="screenshot-placeholder">
        <span>Screenshot: named sessions in the Claude Code sidebar</span>
      </figure>
    </section>

    <!-- Local and cloud -->
    <section class="section">
      <h2>Works locally and in the cloud</h2>
      <p class="section-lede">
        rostr names your agents wherever they run: in a terminal on your laptop, or in a cloud session like Claude Code
        on the web or Codex cloud.
      </p>
      <div class="cards">
        <div class="card">
          <h3>💻 Just your machine</h3>
          <p>
            Everything lives on disk. Drafting is instant, there's no account to make, and nothing goes over the
            network.
          </p>
        </div>
        <div class="card">
          <h3>☁️ Cloud agents too</h3>
          <p>
            Run <code>rostr transfer</code> once and your setup moves to the rostr API at <code>api.getrostr.sh</code>.
            From then on, every session, on your laptop or in the cloud, drafts from the same rosters, so no two agents
            end up with the same name.
          </p>
        </div>
      </div>
    </section>

    <!-- Commands -->
    <section class="section">
      <h2>Commands</h2>
      <p class="section-lede">You only need to run one command. Everything else happens on its own, with more control there when you want it.</p>

      <div class="command-hero">
        <span class="command-badge">⭐ The only one you need</span>
        <pre class="code"><span class="prompt">$</span> rostr create</pre>
        <p>
          rostr picks a random roster for you (or choose one with <code>--preset</code>), and every session you start from
          then on gets drafted automatically.
        </p>
      </div>

      <h3 class="command-group">⚙️ Runs automatically</h3>
      <p class="command-group-lede">Your hooks and the rostr skill run these for you.</p>
      <dl class="commands commands-automatic">
        {AUTOMATIC_COMMANDS.map((item) => (
          <div class="command-row">
            <dt><code>{item.command}</code></dt>
            <dd>{item.description}</dd>
          </div>
        ))}
      </dl>

      <h3 class="command-group">🎛️ When you want more control</h3>
      <dl class="commands">
        {CONTROL_COMMANDS.map((item) => (
          <div class="command-row">
            <dt><code>{item.command}</code></dt>
            <dd>{item.description}</dd>
          </div>
        ))}
      </dl>
      <p class="docs-link"><a href="/cli">Read the full CLI docs →</a></p>
    </section>

    <!-- Rosters -->
    <section class="section">
      <h2>Squad up</h2>
      <p class="section-lede">
        rostr comes with fun pre-built rosters, or you can make your own from any list of names. Hover over a roster to
        meet its A team and B team. Every member gets an emoji; if that's not your thing, turn them off with
        <code>rostr edit</code>.
      </p>
      <ul class="rosters">
        {PRESET_ROSTERS.map((roster) => (
          <li tabindex="0">
            <span class="roster-emoji">{roster.emoji}</span>
            <span>
              <strong>{roster.name}</strong>
              <small>{roster.source}</small>
            </span>
            <div class="roster-teams" role="tooltip">
              <b>A team</b>
              <div class="chips">
                {roster.aTeam.map((member, index) => <span class="chip chip-a" style={`--i: ${index}`}>{member}</span>)}
              </div>
              <b>B team</b>
              <div class="chips">
                {roster.bTeam.map((member, index) => <span class="chip" style={`--i: ${index + 6}`}>{member}</span>)}
              </div>
            </div>
          </li>
        ))}
        <li class="roster-custom" tabindex="0">
          <span class="roster-emoji">✏️</span>
          <span>
            <strong>Your own</strong>
            <small>Any list of names</small>
          </span>
          <div class="roster-teams" role="tooltip">
            <b>A team</b>
            <div class="chips"><span class="chip chip-a" style="--i: 0">⭐ Your six favorites</span></div>
            <b>B team</b>
            <div class="chips"><span class="chip" style="--i: 1">🪑 Everyone else</span></div>
          </div>
        </li>
      </ul>
      <p class="docs-link">
        Made a roster you love? <a href={SUBMIT_ROSTER_URL}>Submit your own →</a>
      </p>

      <div class="cards team-cards">
        <div class="card">
          <h3>🅰️ A team, B team</h3>
          <p>
            Twenty names are too many to get to know, so every roster has a small A team: six by default, picked with
            <code>rostr edit</code>. rostr always drafts from the A team first and only calls up the B team when all your
            starters are busy.
          </p>
        </div>
        <div class="card">
          <h3>📁 A roster per project</h3>
          <p>
            Make as many rosters as you like and give each project its own with <code>rostr use</code>. The Fellowship
            works on rostr, the Smash Bros work on your app, and a name tells you the project as well as the task.
          </p>
        </div>
      </div>
    </section>

    <!-- Build on it -->
    <section class="section">
      <h2>Build on it</h2>
      <p class="section-lede">
        Everything <code>rostr list</code> shows is available as JSON, from the CLI for any roster or from the rostr API
        for cloud rosters. Use it to build your own monitoring, dashboards, and integrations.
      </p>

      <figure class="dashboard" aria-label="Example team dashboard built on rostr list --json">
        <div class="dashboard-bar">
          <span></span><span></span><span></span>
          <span class="dashboard-url">localhost:3000</span>
        </div>
        <div class="dashboard-body">
          <div class="dashboard-header">
            <strong>{DASHBOARD_ROSTER.emoji} app</strong>
            <span>{DASHBOARD_MEMBERS.length} working · {DASHBOARD_IDLE_CHIPS.length} on the bench</span>
          </div>
          <div class="dashboard-grid">
            {DASHBOARD_MEMBERS.map((member) => (
              <div class="agent-card">
                <div class="agent-top">
                  <span class="agent-emoji">{member.emoji}</span>
                  <strong>{member.name}</strong>
                  <span class="status-dot" aria-label="working"></span>
                </div>
                <p class="agent-task">{member.task}</p>
                <div class="agent-meta">
                  <span>{member.where}</span>
                  <span>{member.since}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="dashboard-bench">
            <span class="bench-label">On the bench</span>
            {DASHBOARD_IDLE_CHIPS.map((member) => <span class="chip">{member}</span>)}
          </div>
        </div>
        <figcaption>A team dashboard built on <code>rostr list --json</code>.</figcaption>
      </figure>
      <div class="cards">
        <div class="card">
          <h3>From the CLI</h3>
          <pre class="code"><span class="prompt">$</span> rostr list --json</pre>
          <h3 class="build-subhead">From the API</h3>
          <pre class="code"><span class="prompt">$</span> curl https://api.getrostr.sh/v1/rosters/work \
    -H "Authorization: Bearer $ROSTR_KEY"</pre>
          <p class="build-note">Both return the same JSON.</p>
        </div>
        <div class="card">
          <h3>Response</h3>
          <pre class="code">{LIST_JSON_EXAMPLE}</pre>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section class="section" id="install">
      <h2>Install</h2>
      <div class="cards">
        <div class="card">
          <h3>Ask your agent</h3>
          <p>Point Claude Code or Codex at this page and it will install rostr, set up the hooks and skill, and help you pick a roster.</p>
          <button class="copy copy-block" data-copy={SETUP_PROMPT}>
            <span class="copy-text">“{SETUP_PROMPT}”</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <div class="card">
          <h3>Do it yourself</h3>
          <p>Install with Homebrew, create a roster, then install the hooks and skill for your agents.</p>
          <pre class="code"><span class="prompt">$</span> brew install piazzatron/tap/rostr
<span class="prompt">$</span> rostr create work --preset fellowship
<span class="prompt">$</span> rostr setup <span class="dim"># hooks + skill</span></pre>
        </div>
      </div>
    </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const label = button.querySelector(".copy-label");
        if (!label) return;
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy"), 1500);
      });
    });

    // Keep each roster's A team / B team popover on screen by nudging it left when it would overflow
    document.querySelectorAll<HTMLElement>(".rosters li").forEach((tile) => {
      const popover = tile.querySelector<HTMLElement>(".roster-teams");
      if (!popover) return;
      // Measured a frame later, once the hover style has made the popover visible. Layout sizes (offsetLeft and
      // offsetWidth) ignore the pop-in animation's scale and rotation.
      const keepPopoverOnScreen = () =>
        requestAnimationFrame(() => {
          popover.style.marginLeft = "0px";
          const popoverRight = tile.getBoundingClientRect().left + popover.offsetLeft + popover.offsetWidth;
          const overflow = popoverRight - (document.documentElement.clientWidth - 16);
          if (overflow > 0) popover.style.marginLeft = `${-overflow}px`;
        });
      tile.addEventListener("pointerenter", keepPopoverOnScreen);
      tile.addEventListener("focusin", keepPopoverOnScreen);
    });
  </script>
</Layout>
