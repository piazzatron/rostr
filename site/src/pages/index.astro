---
import { Code } from "astro-expressive-code/components";
import HeroGrid from "../components/HeroGrid.astro";
import SquadBackdrop from "../components/SquadBackdrop.astro";
import Rostr from "../components/Rostr.astro";
import Layout from "../layouts/Layout.astro";
import { ANSI_DIM, ANSI_RESET, toTerminalText } from "../terminal";
import ClaudeIcon from "../assets/claude.svg";
import { PRESET_ROSTERS } from "../data/rosters";
import { TOOL_REQUEST_URL } from "../consts";

// The home page grid shows 10 regular presets, the featured mix, and a "Your own" tile; /rosters shows them all
const HOME_GRID_ROSTERS = [
  ...PRESET_ROSTERS.filter((roster) => !("featuredTag" in roster)).slice(0, 10),
  ...PRESET_ROSTERS.filter((roster) => "featuredTag" in roster),
];

// On phones the grid is trimmed to these presets plus the "Your own" tile
const MOBILE_GRID_ROSTER_IDS = ["fellowship", "hogwarts", "dunder-mifflin", "billionaires", "matrix"];

// The preset roster members easy to place on their own, for the hero's flipping name. Names that read as a common
// first name, a surname, or a plain word ("Jim", "Brown", "Data") are left out
const HERO_FLIPPER_NAMES = [
  ...["🧙 Gandalf", "💍 Frodo", "🌱 Samwise", "👑 Aragorn", "🏹 Legolas", "🪓 Gimli", "✨ Galadriel", "👁️ Sauron", "🐟 Gollum"],
  ...["⚡ Harry", "📚 Hermione", "🧙‍♂️ Dumbledore", "🧪 Snape", "🐉 Hagrid"],
  ...["🍄 Mario", "👻 Luigi", "🗡️ Link", "⭐ Kirby", "🦖 Yoshi", "🦍 Donkey Kong", "🐢 Bowser"],
  ...["🐐 Jordan", "👑 LeBron", "🐍 Kobe", "🦈 Shaq"],
  ...["🍩 Leia", "🐻 Chewie", "🐸 Yoda", "🤖 R2-D2", "🥇 C-3PO", "🏜️ Obi-Wan"],
  ...["🐻 Dwight"],
  ...["🚀 Musk", "📦 Bezos", "🥽 Zuck", "🤖 Altman", "🧠 Amodei", "🪟 Gates", "🍔 Buffett", "🎁 Oprah"],
  ...["🧮 Ada", "🔐 Turing", "📖 Knuth", "🐧 Torvalds", "🗺️ Dijkstra"],
  ...["🦾 Iron Man", "🔨 Thor", "💚 Hulk", "🕷️ Black Widow", "🕸️ Spider-Man", "🐆 Black Panther"],
  ...["🍵 Picard", "⚔️ Worf"],
  ...["🗡️ Arya", "🍷 Tyrion", "🐉 Daenerys", "🦁 Cersei", "🚪 Hodor"],
  ...["☂️ Totoro", "🛁 Chihiro", "🧹 Kiki", "🐠 Ponyo"],
  ...["⚡ Zeus", "🦉 Athena", "🪽 Hermes", "🔱 Poseidon", "💘 Aphrodite", "💀 Hades"],
  ...["⚡ Pikachu", "🔥 Charmander", "🌱 Bulbasaur", "💧 Squirtle", "😴 Snorlax", "🦆 Psyduck", "🧠 Mewtwo"],
  ...["🍜 Naruto", "⚡ Sasuke", "📕 Kakashi"],
  ...["🦄 Ohtani", "🧢 Jeter", "🎯 Ichiro"],
  ...["🐐 Brady", "🪄 Mahomes", "🎉 Gronk"],
  ...["👑 Gretzky", "🧒 Crosby", "🚨 Ovechkin"],
];
// What the hero's flipping agent is on: "🧙 Gandalf is on CI."
// Kept short so the status fits on the same line as "Remember who's doing what." on desktop
const HERO_STATUS_TASKS = ["CI", "billing", "auth", "the docs", "the API", "dark mode", "tests", "search", "perf", "deploys", "logging", "caching"];

// What the squads in Squad up's background pick up, shown in their cursors' labels like session titles
const SQUAD_TASKS = [
  ...["Fix flaky CI", "Dark mode", "Auth redirect", "Speed up search", "Billing migration"],
  ...["Write the docs", "Rate limiting", "Bump Node", "CSV export", "Onboarding"],
];

const SETUP_PROMPT = "Set up rostr for me by following the instructions at https://getrostr.sh";

// The hero's `rostr stats --all`: one roster for work and one for side projects
const HERO_ROSTERS = [
  {
    name: "work",
    drafted: [
      { emoji: "🧙", name: "Gandalf", task: "Fix auth redirect loop", where: "acme/api", since: "12m" },
      { emoji: "💍", name: "Frodo", task: "Flaky e2e tests on CI", where: "acme/web", since: "3m" },
      { emoji: "🌱", name: "Samwise", task: "Migrate billing to Stripe v3", where: "acme/billing", since: "1h" },
    ],
    idle: ["Aragorn", "Legolas", "Gimli", "Boromir", "Merry", "Pippin"],
  },
  {
    name: "side",
    drafted: [
      { emoji: "🐐", name: "Jordan", task: "Port the recipe app to iOS", where: "me/recipes", since: "40m" },
      { emoji: "👑", name: "LeBron", task: "Add dark mode to the blog", where: "me/blog", since: "5m" },
    ],
    idle: ["Kobe", "Magic", "Bird", "Curry", "Shaq", "Kareem"],
  },
];

// The CLI section's `rostr --help`: the key commands in each group, each group and command linking to its place in the
// CLI docs
const CLI_HELP_GROUPS = [
  {
    href: "/cli#roster-commands",
    title: "🎯 Roster commands",
    commands: [
      { name: "assemble", summary: "Set up a roster" },
      { name: "link", summary: "Pick a repo's roster" },
      { name: "stats", summary: "See who's working on what" },
    ],
  },
  {
    href: "/cli#agent-commands",
    title: "🤖 Agent commands",
    note: "your hooks run these",
    commands: [
      { name: "draft", summary: "Draft an agent, or /draft" },
      // bench is documented with draft
      { name: "bench", href: "/cli#draft", summary: "Send it back to the bench" },
    ],
  },
];


// The "Build on it" dashboard example uses the Smash Bros roster
const DASHBOARD_ROSTER = PRESET_ROSTERS.find((roster) => roster.id === "smash-bros")!;
// What GET /v1/stats gives a dashboard: each drafted agent's name, emoji, task, repo, and when it was drafted (here,
// minutes ago), and everyone idle
const DASHBOARD_MEMBERS = [
  { emoji: "🍄", name: "Mario", task: "Ship the onboarding redesign", repo: "acme/web", minutes: 25 },
  { emoji: "🗡️", name: "Link", task: "Fix flaky checkout test", repo: "acme/api", minutes: 8 },
  { emoji: "⭐", name: "Kirby", task: "Upgrade the image pipeline", repo: "acme/api", minutes: 124 },
  { emoji: "🚀", name: "Samus", task: "Add rate limiting to the API", repo: "acme/billing", minutes: 50 },
];
// The idle members in the order they'd be drafted: here no one else has been drafted yet, so roster order
const DASHBOARD_IDLE = DASHBOARD_ROSTER.members.filter(
  (member) => !DASHBOARD_MEMBERS.some((working) => member.endsWith(` ${working.name}`)),
);
// Tasks the demo deals out when an agent's task changes or a new one is drafted
const DASHBOARD_TASKS = [
  "Write the invoices migration",
  "Speed up search indexing",
  "Review the auth PR",
  "Bump Node to 24",
  "Add dark mode to settings",
  "Clean up feature flags",
  "Fix the CSV export",
  "Profile the slow dashboard query",
  "Add retries to the webhook worker",
  "Split up the billing service",
];
// Time since drafting, like a stopwatch: 8:00, or 2:04:00 past an hour
const formatElapsed = (minutes: number) =>
  minutes >= 60 ? `${Math.floor(minutes / 60)}:${String(minutes % 60).padStart(2, "0")}:00` : `${minutes}:00`;

// Terminal examples, rendered with Expressive Code
const HERO_LIST_EXAMPLE = toTerminalText(
  [
    "$ rostr stats",
    ...HERO_ROSTERS.flatMap((roster, index) => [
      ...(index > 0 ? [""] : []),
      `${ANSI_DIM}${roster.name} roster${ANSI_RESET}`,
      ...roster.drafted.map(
        (member) => `${member.emoji} ${member.name.padEnd(8)} ${member.task.padEnd(30)} ${member.where.padEnd(13)} ${member.since}`,
      ),
      `${ANSI_DIM}bench: ${roster.idle.join(", ")}${ANSI_RESET}`,
    ]),
  ].join("\n"),
);
// Command-only blocks use plain shell (no "$"), so their copy buttons copy runnable commands
const INSTALL_EXAMPLE = `curl -fsSL https://getrostr.sh/install | sh
rostr assemble`;
const INSTALL_SCRIPT_SOURCE = "https://github.com/piazzatron/rostr/blob/main/site/public/install";
const API_EXAMPLE = `curl https://api.getrostr.sh/v1/stats \\
  -H "Authorization: Bearer $ROSTR_TOKEN"`;
// Pasted to an agent so it can write the ~15 lines that derive the auth token and decrypt tasks and repos
const DECRYPT_PROMPT = `Build me a dashboard of my rostr agents using the rostr API. My rostr key is in ROSTR_KEY: "rostr_sk_" followed by 32 bytes as base64url. Derive two 32-byte keys from those bytes with HKDF-SHA256 (no salt): info "auth" is the bearer token (send it base64url-encoded), and info "encrypt" is an AES-256-GCM key. Fetch GET https://api.getrostr.sh/v1/stats with that token. Each drafted agent's task and repo are base64: the first 12 bytes are the nonce, and the rest is the ciphertext and tag.`;

const LIST_JSON_EXAMPLE = `{
  "rosters": [
    {
      "name": "work",
      "drafted": [
        {
          "name": "Gandalf",
          "emoji": "🧙",
          "task": "Fix auth redirect loop",
          "repo": "acme/api",
          "draftedAt": "2026-10-19T03:12:00Z"
        }
      ],
      "idle": [
        {
          "name": "Aragorn",
          "emoji": "👑"
        }
      ]
    }
  ]
}`;

// The herdr sidebar in the tools section, one agent per pane
const HERDR_AGENTS = ["🌅 Luke", "🍩 Leia"];

// A cloud, the mark the Claude app puts on its cloud sessions
const CLOUD_ICON =
  "M7 18.5h10.5a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.6 9.2 4.65 4.65 0 0 0 7 18.5z";

// A folder, the mark the Codex app puts on each project
const FOLDER_ICON =
  "M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2h9A1.5 1.5 0 0 1 21 9.5v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z";

// The live bar along the bottom of the page is off for now; the hanging live board replaces it
const SHOW_LIVE_BAR = false;
---

<Layout
  title="rostr · give your agents names"
  description="rostr gives each coding agent a name from a roster you pick, so you remember who's doing what. Works with Claude Code, Codex, and terminal multiplexers."
>
    <!-- Hero -->
    <section class="hero">
      <HeroGrid />
      <h1>Give your agents names.</h1>
      <p class="hero-subtitle">
        Remember who's doing what.{" "}
        <span class="hero-status" aria-hidden="true">
          <span class="name-flipper" data-names={JSON.stringify(HERO_FLIPPER_NAMES)}>
            <span><span class="status-emoji">🧙</span>Gandalf</span>
          </span>{" "}
          <span class="hero-status-task">
            is on <span class="task-text" data-tasks={JSON.stringify(HERO_STATUS_TASKS)}>auth</span>.
          </span>
        </span>
      </p>
      <p class="lede">
        <Rostr /> automatically gives every agent session a unique name, drafted from a team you set. It works across your
        machines and in the cloud.
      </p>
      <p class="cta-title">Get started: paste this into your agent</p>
      <div class="cta">
        <button class="copy copy-hero" data-copy={SETUP_PROMPT}>
          <span class="copy-text">“{SETUP_PROMPT}”</span>
          <span class="copy-label">Copy</span>
        </button>
      </div>
      <a class="cta-alt" href="#install">or run the install script ↓</a>

      <div class="hero-terminal">
        <Code code={HERO_LIST_EXAMPLE} lang="ansi" frame="terminal" />
        <div class="notification scene-notification is-waiting hero-notification hero-notification-claude">
          <span class="notification-icon"><ClaudeIcon aria-hidden="true" /></span>
          <div class="notification-text">
            <div class="notification-top"><strong>🌱 Samwise · Migrate billing</strong><span>now</span></div>
            <p>Claude is waiting for your input</p>
          </div>
        </div>
        <div class="notification hero-notification hero-notification-slack">
          <span class="notification-icon notification-icon-slack" aria-hidden="true">#</span>
          <div class="notification-text">
            <div class="notification-top"><strong>🧙 Gandalf</strong><span>now</span></div>
            <p>Needs your input on the auth redirect loop</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section" id="how-it-works">
      <h2>How it works</h2>
      <p class="section-lede">
        <Rostr /> is a small <a class="accent-link" href="/cli">CLI</a>, a few hooks, and a skill for your agent.
      </p>
      <ol class="steps">
        <li>
          <h3>Assemble your roster</h3>
          <p>Run <code>rostr assemble</code>, or ask your agent to do it for you.</p>
        </li>
        <li>
          <h3>New sessions draft your team</h3>
          <p>Each session's title shows its agent's name, and the agent knows who it is.</p>
        </li>
        <li>
          <h3>Done? Back to the bench</h3>
          <p>
            When a session ends, the agent's identity automatically returns to the bench.
          </p>
        </li>
      </ol>
      <p class="docs-link"><a href="/how-it-works">Learn how <Rostr /> works under the hood →</a></p>
    </section>

    <!-- Tools -->
    <section class="section" id="tools">
      <h2>Plays well with your tools</h2>
      <p class="section-lede">
        <Rostr /> integrates with Claude Code and Codex TUI and desktop apps, as well as herdr and tmux.
      </p>
      <div class="tools">
        <figure class="tool tool-claude">
          <div class="tool-window" aria-hidden="true">
            <div class="tool-chrome"><span></span><span></span><span></span></div>
            <ul>
              <li><span>🧙 Gandalf · Ship v2</span><i class="tool-claude-dot"></i></li>
              <li class="is-active"><span>💍 Frodo · Fix login</span><i class="tool-claude-dot"></i></li>
              <li><span>👑 Aragorn · Add docs</span><svg viewBox="0 0 24 24"><path d={CLOUD_ICON} /></svg></li>
            </ul>
          </div>
          <figcaption>Claude Code</figcaption>
        </figure>

        <figure class="tool tool-codex-app">
          <div class="tool-window" aria-hidden="true">
            <div class="tool-chrome"><span></span><span></span><span></span></div>
            <p class="tool-codex-app-project">
              <svg viewBox="0 0 24 24"><path d={FOLDER_ICON} /></svg>
              app<i></i>
            </p>
            <ul>
              <li>🍄 Mario · Fix tests</li>
              <li>🗡️ Link · Add search</li>
            </ul>
          </div>
          <figcaption>Codex</figcaption>
        </figure>

        <figure class="tool tool-tmux">
          <div class="tool-window tool-term" aria-hidden="true">
            <p class="tool-tmux-border"><span>📚 Hermione · Bump pgx</span></p>
            <div class="tool-tmux-body">
              <p class="tool-tmux-prompt">› Bump pgx to v5</p>
            </div>
            <p class="tool-tmux-bar"><span>1:🌙 Luna</span><span class="is-active">2:📚 Hermione*</span></p>
          </div>
          <figcaption>tmux</figcaption>
        </figure>

        <figure class="tool tool-herdr">
          <div class="tool-window tool-term" aria-hidden="true">
            <ul>
              {HERDR_AGENTS.map((agent, i) => (
                <li class:list={{ "is-active": i === 0 }}>
                  <span class="tool-herdr-pane">○ <b>web</b> · {i + 1}</span>
                  <span class="tool-herdr-name">{agent}</span>
                </li>
              ))}
            </ul>
          </div>
          <figcaption>herdr</figcaption>
        </figure>
      </div>
      <p class="docs-link"><a href={TOOL_REQUEST_URL}>Using something else? Request it →</a></p>
    </section>

    <!-- Rosters -->
    <section class="section squad-section">
      <SquadBackdrop rosters={HOME_GRID_ROSTERS.map((roster) => roster.members)} tasks={SQUAD_TASKS} />
      <h2>Squad up</h2>
      <p class="section-lede">
        Pick a pre-built roster or <code>rostr assemble</code> your own. Every agent gets its own emoji (which you can
        turn off).
      </p>
      <ul class="rosters">
        {HOME_GRID_ROSTERS.map((roster) => (
          <li
            tabindex="0"
            class:list={{
              "roster-featured": "featuredTag" in roster,
              "roster-desktop-only": !MOBILE_GRID_ROSTER_IDS.includes(roster.id),
            }}
          >
            {"featuredTag" in roster && <span class="roster-tag">{roster.featuredTag}</span>}
            <span class="roster-emoji">{roster.emoji}</span>
            <span>
              <strong>{roster.name}</strong>
              <small>{roster.source}</small>
            </span>
            <div class="roster-members" role="tooltip">
              <b>{roster.members.length} members</b>
              <div class="chips">
                {roster.members.map((member) => <span class="chip">{member}</span>)}
              </div>
            </div>
          </li>
        ))}
        <li class="roster-custom" tabindex="0">
          <span class="roster-emoji">✏️</span>
          <span>
            <strong>Your own</strong>
            <small>Any list of names</small>
          </span>
          <div class="roster-members" role="tooltip">
            <b>As many as you like</b>
            <div class="chips">
              <span class="chip">⭐ Your favorites</span>
              <span class="chip">🪑 Everyone else</span>
            </div>
          </div>
        </li>
      </ul>
      <p class="docs-link">
        <a href="/rosters">See all {PRESET_ROSTERS.length} rosters / submit your own →</a>
      </p>

      <div class="tip">
        <span class="tip-icon" aria-hidden="true">📁</span>
        <p>
          <strong>Tip: different rosters for different projects.</strong> Run <code>rostr link</code> in a repo to give it
          its own roster, so you can tell projects apart at a glance.
        </p>
      </div>
    </section>

    <!-- Why -->
    <section class="section">
      <h2>Why anthropomorphize?</h2>
      <ol class="value-list">
        <li>
          <h3>It exploits your human psychology</h3>
          <p>Your brain is built to remember people and what they're doing, not "25 independent work streams".</p>
        </li>
        <li>
          <h3>Notifications become easy to triage</h3>
          <p>When a notification says 🌱 Samwise, you know what it's about before you open it.</p>
        </li>
        <li>
          <h3>Every message gets provenance</h3>
          <p>
            When an agent pings you on Slack, GitHub, or email, it signs its name, so you know exactly which session it came
            from.
          </p>
        </li>
        <li>
          <h3>Agents can find each other</h3>
          <p>"Check with Hermione before you merge."</p>
        </li>
      </ol>
      <p class="value-closer">Also, it's really funny.</p>
    </section>

    <!-- CLI -->
    <section class="section" id="cli">
      <h2><Rostr /> CLI</h2>
      <p class="section-lede">
        <Rostr /> comes equipped with a thoughtfully designed CLI (that you'll never need to touch).
      </p>
      <div class="cli-help">
        <div class="cli-help-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="cli-help-body">
          <p class="cli-help-prompt"><span aria-hidden="true">$ </span><b>rostr --help</b></p>
          <div class="cli-help-groups">
            {CLI_HELP_GROUPS.map((group) => (
              <div>
                <p class="cli-help-group">
                  <a href={group.href}>{group.title}</a>
                  {group.note && <span>({group.note})</span>}
                </p>
                <dl>
                  {group.commands.map((command) => (
                    <div>
                      <dt><a href={command.href ?? `/cli#${command.name}`}>{command.name}</a></dt>
                      <dd>{command.summary}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="docs-link"><a href="/cli">Read the full CLI docs →</a></p>
    </section>

    <!-- Local and cloud -->
    <section class="section" id="local-and-cloud">
      <h2>Local and Cloud Rosters</h2>
      <dl class="modes">
        <div>
          <dt>💻 Local</dt>
          <dd>The default, nothing leaves your machine.</dd>
        </div>
        <div>
          <dt>☁️ Cloud</dt>
          <dd>
            For when you run agents in the cloud or across different machines. No account needed; agent task and repo
            metadata are end-to-end encrypted. <a class="accent-link" href="/privacy"
              >Learn more about privacy →</a
            >
          </dd>
        </div>
      </dl>
      <p class="modes-note">
        Set up during <code>rostr assemble</code>, or migrate to the cloud later with <code>rostr cloud on</code>.
      </p>
    </section>

    <!-- Build on it -->
    <section class="section">
      <h2>Build on it</h2>
      <p class="section-lede">
        Use the output of <code>rostr stats --json</code> or the list API endpoint to build your own dashboards,
        monitoring, and integrations.
      </p>

      <figure
        class="dashboard"
        aria-label="Example team dashboard built on rostr stats --json"
        data-tasks={JSON.stringify(DASHBOARD_TASKS)}
      >
        <div class="dashboard-app">
          <div class="dashboard-bar">
            <span></span><span></span><span></span>
            <span class="dashboard-url">localhost:3000</span>
            <span class="dashboard-updated">Updated just now</span>
          </div>
          <div class="dashboard-body">
            <div class="dashboard-header">
              <strong>{DASHBOARD_ROSTER.emoji} app</strong>
              <span>{DASHBOARD_MEMBERS.length} working · {DASHBOARD_IDLE.length} on the bench</span>
            </div>
            <div class="dashboard-grid">
              {DASHBOARD_MEMBERS.map((member) => (
                <div class="agent-card" data-minutes={member.minutes}>
                  <div class="agent-top">
                    <span class="agent-emoji">{member.emoji}</span>
                    <strong class="agent-name">{member.name}</strong>
                  </div>
                  <p class="agent-task">{member.task}</p>
                  <div class="agent-meta">
                    <span class="agent-repo">{member.repo}</span>
                    <span class="agent-time">{formatElapsed(member.minutes)}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="dashboard-bench">
              <span class="bench-label">On the bench</span>
              {DASHBOARD_IDLE.map((member) => <span class="chip">{member}</span>)}
            </div>
          </div>
        </div>
        <figcaption>A dashboard for your team, built on <code>rostr stats --json</code>.</figcaption>
      </figure>
      <div class="cards build-cards">
        <div class="card">
          <h3>💻 On your machine</h3>
          <Code code="rostr stats --json" lang="sh" />
          <p class="build-note">Local or cloud mode. Tasks and repos come back decrypted.</p>
          <h3 class="build-subhead">🌐 On the web</h3>
          <Code code={API_EXAMPLE} lang="sh" />
          <p class="build-note">
            Cloud mode. Get your token with <code>rostr config key --token</code>. Rosters and who's drafted come back
            readable; tasks and repos stay end-to-end encrypted.
          </p>
          <button class="copy-link" data-copy={DECRYPT_PROMPT}>
            <span class="copy-label">📋 Copy a prompt that teaches your agent to decrypt them</span>
          </button>
        </div>
        <div class="card">
          <h3>Response</h3>
          <Code code={LIST_JSON_EXAMPLE} lang="json" />
        </div>
      </div>

    </section>

    <!-- Why I built this -->
    <section class="section narrow" id="why-i-built-this">
      <h2>Why I built this</h2>
      <p>
        First, a concrete reason: when you use a multi-agent workflow, you need a way for your agents to phone home when
        they get stuck. Teaching your agents to reach out allows you to start tasks, switch gears, then come back later
        and respond to a batch of queries. But it also creates a new problem: how do you know which session this message
        came from? Auto-generated summaries don't cut it, especially if you're working on similar features. You can link
        back to the session, but that's not visually scannable. You need names! Ideally, memorable ones. And emojis. Lots
        of emojis.
      </p>
      <p>
        Then I thought about it more: we should have cross-platform, stable agent identities as a primitive. I was
        inspired by the named agents in <a href="https://github.com/gastownhall/gastown">Gas Town</a>, but didn't want to
        bring in that whole kitchen sink.
      </p>
      <p>
        <Rostr /> is also an experiment in exercising some restraint with using agents. What if we ran our agent teams
        more like an EM would run a lean human team? It's tempting to spin up countless agents, fry your poor human
        noggin, and wake up the next morning to a demoralizing tangle of sessions and notification soup. Or maybe it's
        just me. Just drafted Dumbledore 3? Time to touch grass.
      </p>
    </section>

    <!-- Install -->
    <section class="section" id="install">
      <h2>Install</h2>
      <div class="cards">
        <div class="card">
          <h3>Ask your agent</h3>
          <p>
            Point Claude Code or Codex at this page and it will install <Rostr />, set up the hooks and skill, and help you
            pick a roster. Agents: your setup steps are at <a href="/setup.md">getrostr.sh/setup.md</a>.
          </p>
          <button class="copy copy-block" data-copy={SETUP_PROMPT}>
            <span class="copy-text">“{SETUP_PROMPT}”</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <div class="card">
          <h3>Run the install script</h3>
          <p>
            Install <Rostr />, then assemble your roster. It walks you through the choices and sets up the
            hooks. <a href={INSTALL_SCRIPT_SOURCE}>See the script</a>.
          </p>
          <Code code={INSTALL_EXAMPLE} lang="sh" />
          <p class="build-note">
            On a Mac with Homebrew, <code>brew install piazzatron/tap/rostr</code> works too.
          </p>
        </div>
      </div>
      <p class="install-cloud">
        <strong>Cloud sessions</strong> (Claude Code on the web, Codex cloud): add the install line to your environment's
        setup script, set <code>ROSTR_KEY</code> to the key from <code>rostr config key</code>, and
        allow <code>github.com</code> and <code>api.getrostr.sh</code> in its network settings.
      </p>
    </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const label = button.querySelector(".copy-label");
        if (!label) return;
        const original = label.textContent;
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = original), 1500);
      });
    });

    // The tools rise in one after another the first time the row scrolls into view. They start hidden only once this
    // runs, so without JavaScript they simply show
    const tools = document.querySelector<HTMLElement>(".tools");
    if (tools && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      tools.classList.add("is-waiting");
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          tools.classList.replace("is-waiting", "is-in");
          observer.disconnect();
        },
        { threshold: 0.3 },
      );
      observer.observe(tools);
    }

    // Every 1.3s the hero's status line ("🧙 Gandalf is on CI.") deals a new agent and task, starting once the hero has
    // finished fading in. The name springs in from below while the old one slides out; the task just flicks over. With
    // reduced motion both simply swap.
    const flipper = document.querySelector<HTMLElement>(".name-flipper");
    const taskText = document.querySelector<HTMLElement>(".task-text");
    if (flipper && taskText) {
      const allNames: string[] = JSON.parse(flipper.dataset.names ?? "[]");
      const tasks: string[] = JSON.parse(taskText.dataset.tasks ?? "[]");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // A name like "🧙 Gandalf" renders as the emoji in its own span, which sets a tighter gap than a monospace space
      const fillName = (element: HTMLElement, name: string) => {
        const [emoji, ...rest] = name.split(" ");
        const emojiSpan = document.createElement("span");
        emojiSpan.className = "status-emoji";
        emojiSpan.textContent = emoji;
        element.replaceChildren(emojiSpan, rest.join(" "));
      };

      // Keep only the names that fit between where the name starts and the end of the line, leaving room for the
      // longest " is on <task>." (on phones the task wraps onto its own line, so it needs no room). Measured once at load.
      const line = document.querySelector(".hero-subtitle") as HTMLElement;
      const taskPart = taskText.parentElement as HTMLElement;
      const probe = document.createElement("span");
      probe.style.cssText = "position: absolute; visibility: hidden; white-space: nowrap";
      flipper.parentElement?.append(probe);
      const widthOf = (text: string) => {
        probe.textContent = text;
        return probe.offsetWidth;
      };
      const nameWidth = (name: string) => {
        fillName(probe, name);
        return probe.offsetWidth;
      };
      const nameStart = flipper.getBoundingClientRect().left - line.getBoundingClientRect().left;
      const taskPartWidth =
        getComputedStyle(taskPart).display === "block" ? 0 : Math.max(...tasks.map((task) => widthOf(` is on ${task}.`)));
      const names = allNames.filter((name) => nameStart + nameWidth(name) + taskPartWidth <= line.clientWidth);
      probe.remove();

      // Deal names and tasks from shuffled decks so neither repeats until all have been shown
      const makeDealer = (items: string[]) => {
        let deck: string[] = [];
        return () => {
          if (deck.length === 0) deck = [...items].sort(() => Math.random() - 0.5);
          return deck.pop() ?? "";
        };
      };
      const dealName = makeDealer(names);
      const dealTask = makeDealer(tasks);

      // The name slot is as wide as its current name, so " is on" sits right after it
      flipper.style.width = `${(flipper.firstElementChild as HTMLElement).offsetWidth}px`;

      const deal = () => {
        const outgoing = flipper.lastElementChild as HTMLElement;
        const incoming = document.createElement("span");
        fillName(incoming, dealName());
        flipper.append(incoming);
        flipper.style.width = `${incoming.offsetWidth}px`;
        taskText.textContent = dealTask();

        if (reduceMotion) {
          outgoing.remove();
          return;
        }
        outgoing.classList.add("is-leaving");
        outgoing.addEventListener("animationend", () => outgoing.remove(), { once: true });
        incoming.classList.add("is-entering");
        taskText.classList.remove("is-swapping");
        void taskText.offsetWidth; // restart the task's animation
        taskText.classList.add("is-swapping");
      };
      setTimeout(() => {
        deal();
        setInterval(deal, 1300);
      }, 2600);
    }

    // The live board (agents at work in split flaps, and on the bench), and the live bar when it's on: agents working
    // and on the bench, across everyone (see docs/live-counts.md). A socket to the live Worker at PUBLIC_LIVE_URL pushes
    // each change as it happens; a dropped socket retries after 5s, 10s, 30s, then every 60s. They show once there's a
    // drafted agent to count, and the bar slides up once the visitor scrolls down.
    const liveEls = [...document.querySelectorAll<HTMLElement>(".live-board, .live-bar")];
    if (liveEls.length) {
      type Counts = { working: number; benched: number };
      const LIVE_URL: string = import.meta.env.PUBLIC_LIVE_URL ?? "";
      const RETRY_DELAYS_MS = [5_000, 10_000, 30_000, 60_000];
      const COUNT_MS = 600;
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let onScreen: Counts = { working: 0, benched: 0 };
      let frame = 0;

      const render = (counts: Counts) => {
        onScreen = counts;
        const set = (selector: string, text: string) =>
          liveEls.forEach((live) => live.querySelectorAll(selector).forEach((el) => (el.textContent = text)));
        set(".live-drafted", counts.working.toLocaleString("en-US"));
        set(".live-drafted-label", counts.working === 1 ? "agent drafted" : "agents drafted");
        set(".live-total", (counts.working + counts.benched).toLocaleString("en-US"));
        set(".live-benched", counts.benched.toLocaleString("en-US"));
      };

      // The board's agents at work are split flaps that only turn forward, 0 to 9 and round again, one flap at a time until
      // each shows its digit, like a station's departures board. They start blank, so the first counts turn in. A
      // number has at least two digits, zero-padded, and gains a flap on the left when it needs one; the flaps shrink
      // as they're added, with a gap where the thousands comma would go. They hold still until the board drops.
      const DIGITS = "0123456789";
      const FLAP_MS = 160; // the top half falling, then the bottom half landing
      type Flap = { el: HTMLElement; shown: string; target: string; turning: boolean };
      const makeFlap = (): Flap => {
        const el = document.createElement("span");
        el.className = "flap";
        el.innerHTML = ["flap-top", "flap-bottom", "flap-fold-top", "flap-fold-bottom"]
          .map((half) => `<span class="${half}"><i> </i></span>`)
          .join("");
        return { el, shown: " ", target: " ", turning: false };
      };
      const paint = (flap: Flap, half: string, char: string) => (flap.el.querySelector(`.${half} i`)!.textContent = char);
      const turn = (flap: Flap) => {
        if (flap.shown === flap.target) {
          flap.turning = false;
          return;
        }
        flap.turning = true;
        const next = flap.shown === " " ? "0" : DIGITS[(DIGITS.indexOf(flap.shown) + 1) % DIGITS.length];
        paint(flap, "flap-top", next);
        paint(flap, "flap-fold-top", flap.shown);
        paint(flap, "flap-fold-bottom", next);
        flap.el.classList.remove("is-turning");
        void flap.el.offsetWidth; // restarts the animation
        flap.el.classList.add("is-turning");
        setTimeout(() => {
          paint(flap, "flap-bottom", next);
          flap.el.classList.remove("is-turning");
          flap.shown = next;
          turn(flap);
        }, FLAP_MS);
      };
      const flapsEl = document.querySelector<HTMLElement>(".flaps");
      const flaps: Flap[] = [];
      const setFlaps = (working: number) => {
        if (!flapsEl) return;
        const digits = String(working);
        flapsEl.setAttribute("aria-label", digits);
        while (flaps.length < Math.max(2, digits.length)) {
          const flap = makeFlap();
          flaps.unshift(flap);
          flapsEl.prepend(flap.el);
        }
        const chars = digits.padStart(flaps.length, "0");
        flapsEl.dataset.digits = String(flaps.length);
        flaps.forEach((flap, i) => {
          flap.el.classList.toggle("is-thousands", i > 0 && (flaps.length - i) % 3 === 0);
          flap.target = chars[i];
          if (reduceMotion) {
            ["flap-top", "flap-bottom"].forEach((half) => paint(flap, half, flap.target));
            flap.shown = flap.target;
          } else if (!flap.turning && boardDropped) {
            turn(flap);
          }
        });
      };

      // The board hangs out of sight above the screen, then drops 0.6s after load (or once there are counts, if they're
      // later), as long as the visitor hasn't scrolled away. It falls until the wire goes taut, bobs on the wire's
      // stretch, and swings in depth like a hanging sheet of paper: the jolt throws its bottom out toward the viewer,
      // and it swings back and forth in depth, each swing back just reaching the page rather than hitting it, smaller
      // each time, until it rests flat against the page. The wire stays anchored to the top of the screen throughout,
      // paying out as the board falls and stretching as it bobs, and the board swings from that anchor. Its shadow on
      // the page moves with it. The motion is simulated once and played as keyframes, and the flaps start turning just
      // after the jolt. Scrolling down reels it back up out of sight, and it drops again once the visitor is back at
      // the top of the page.
      const DROP_DELAY_MS = 600;
      const RETRACT_AFTER_PX = 120; // scrolled this far down, it's reeled up
      const RETRACT_MS = 500;
      const liveBoard = document.querySelector<HTMLElement>(".live-board");
      const rig = liveBoard?.querySelector<HTMLElement>(".live-board-rig");
      const wire = liveBoard?.querySelector<HTMLElement>(".live-board-wire");
      const sign = liveBoard?.querySelector<HTMLElement>(".live-board-sign");
      const shadow = liveBoard?.querySelector<HTMLElement>(".live-board-shadow");
      let boardDropped = false;
      let dropWanted = false;
      const startTurning = () => {
        boardDropped = true;
        flaps.forEach((flap) => !flap.turning && turn(flap));
      };
      // y is the board's offset from where it rests: negative above, positive below
      const dropMotion = (wirePx: number, signPx: number) => {
        const fallPx = wirePx + signPx + 24;
        const FPS = 60;
        const GRAVITY = 3200; // px/s²
        const fallS = Math.sqrt((2 * fallPx) / GRAVITY);
        // From the moment the wire goes taut: a damped bob down and back on its stretch, and the swing out from the page
        const bob = { w: 2 * Math.PI * 2.2, damping: 0.35, speed: 260 }; // rad/s, damping ratio, px/s downward
        // In depth, each swing back slows to a stop just as it reaches the page, so it never hits it: (1 - cos) is 0
        // with no speed at the end of each swing, and the swings shrink as they decay
        const swing = { w: 2 * Math.PI, decay: 0.9, size: 10 }; // rad/s, per second, degrees (half the first swing)
        const settleS = 2.8;
        const rigFrames: Keyframe[] = [];
        const wireFrames: Keyframe[] = [];
        const signFrames: Keyframe[] = [];
        const shadowFrames: Keyframe[] = [];
        for (let i = 0; i <= Math.round((fallS + settleS) * FPS); i++) {
          const t = i / FPS;
          let y = -fallPx + (GRAVITY * t * t) / 2;
          let deg = 0;
          if (t >= fallS) {
            const s = t - fallS;
            const bobW = bob.w * Math.sqrt(1 - bob.damping ** 2);
            y = (bob.speed / bobW) * Math.exp(-bob.damping * bob.w * s) * Math.sin(bobW * s);
            // What's left of the swing fades out over the last 0.4s, so it ends exactly flat
            const fade = Math.min(1, (settleS - s) / 0.4);
            deg = fade * swing.size * Math.exp(-swing.decay * s) * (1 - Math.cos(swing.w * s));
          }
          // The wire runs from the top of the screen to the board, so it's as long as the board is low; while the board
          // is still above the screen there's no wire showing and the board itself is moved up
          rigFrames.push({ rotate: `x ${deg.toFixed(3)}deg` });
          wireFrames.push({ height: `${Math.max(0, wirePx + y).toFixed(2)}px` });
          signFrames.push({ translate: `0 ${Math.min(0, wirePx + y).toFixed(2)}px` });
          // The further out the bottom, the further down and softer its shadow falls; perspective makes the board look
          // bigger and lower as it comes out, so the shadow has to drop further than that to show beneath it
          const out = Math.sin((deg * Math.PI) / 180);
          shadowFrames.push({
            translate: `0 ${(y + 3 + out * signPx * 1.1).toFixed(2)}px`,
            opacity: (0.18 + out * 1.6).toFixed(3),
            filter: `blur(${(4 + out * 16).toFixed(1)}px)`,
          });
        }
        return {
          rigFrames,
          wireFrames,
          signFrames,
          shadowFrames,
          durationMs: (fallS + settleS) * 1000,
          tautMs: fallS * 1000,
        };
      };
      let retracting = false;
      const dropBoard = () => {
        dropWanted = true;
        if (!liveBoard || !rig || !wire || !sign || liveBoard.hidden) return;
        if (liveBoard.classList.contains("is-dropped") || retracting || window.scrollY > RETRACT_AFTER_PX) return;
        liveBoard.classList.add("is-dropped");
        if (shadow) {
          shadow.style.width = `${sign.offsetWidth}px`;
          shadow.style.height = `${sign.offsetHeight}px`;
        }
        if (reduceMotion || !rig.offsetHeight) {
          startTurning();
          return;
        }
        const motion = dropMotion(wire.offsetHeight, sign.offsetHeight);
        const timing = { duration: motion.durationMs, easing: "linear" };
        rig.animate(motion.rigFrames, timing);
        wire.animate(motion.wireFrames, timing);
        sign.animate(motion.signFrames, timing);
        shadow?.animate(motion.shadowFrames, timing);
        setTimeout(startTurning, motion.tautMs + 150);
      };

      // Reels the board up from wherever it is (mid-drop too), speeding up as it goes, then drops it again if the
      // visitor is back at the top by the time it's gone
      const retractBoard = () => {
        if (!liveBoard || !rig || !wire || !sign || retracting || !liveBoard.classList.contains("is-dropped")) return;
        const parts = [rig, wire, sign, shadow].filter((el): el is HTMLElement => !!el);
        const finish = () => {
          parts.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));
          liveBoard.classList.remove("is-dropped");
          retracting = false;
          if (window.scrollY <= 0) dropBoard();
        };
        if (reduceMotion) {
          finish();
          return;
        }
        retracting = true;
        // Where it is now, then where it rests, so the reel starts from the current spot
        const rotated = getComputedStyle(rig).rotate;
        const fromDeg = rotated === "none" ? 0 : parseFloat(rotated.split(" ").pop()!);
        // The board's top is the wire's length plus how far the board's been moved up
        const signShift = parseFloat(getComputedStyle(sign).translate.split(" ")[1] ?? "0") || 0;
        const top = parseFloat(getComputedStyle(wire).height) + signShift;
        const fromShadowOpacity = shadow ? parseFloat(getComputedStyle(shadow).opacity) : 0;
        parts.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));
        const restWirePx = wire.offsetHeight;
        const distance = top + sign.offsetHeight + 24;
        const frames = Math.round((RETRACT_MS / 1000) * 60);
        const rigFrames: Keyframe[] = [];
        const wireFrames: Keyframe[] = [];
        const signFrames: Keyframe[] = [];
        const shadowFrames: Keyframe[] = [];
        for (let i = 0; i <= frames; i++) {
          const progress = i / frames;
          const boardTop = top - distance * progress ** 2;
          rigFrames.push({ rotate: `x ${(fromDeg * Math.max(0, 1 - progress * 2)).toFixed(3)}deg` });
          wireFrames.push({ height: `${Math.max(0, boardTop).toFixed(2)}px` });
          signFrames.push({ translate: `0 ${Math.min(0, boardTop).toFixed(2)}px` });
          shadowFrames.push({
            translate: `0 ${(boardTop - restWirePx + 3).toFixed(2)}px`,
            opacity: (fromShadowOpacity * (1 - progress)).toFixed(3),
          });
        }
        const timing = { duration: RETRACT_MS, easing: "linear", fill: "forwards" as const };
        rig.animate(rigFrames, timing);
        wire.animate(wireFrames, timing).addEventListener("finish", finish);
        sign.animate(signFrames, timing);
        shadow?.animate(shadowFrames, timing);
      };

      setTimeout(dropBoard, reduceMotion ? 0 : DROP_DELAY_MS);
      window.addEventListener(
        "scroll",
        () => {
          if (window.scrollY > RETRACT_AFTER_PX) retractBoard();
          else if (window.scrollY <= 0 && dropWanted) dropBoard();
        },
        { passive: true },
      );

      // Counts up or down from the numbers on screen; the first counts, and reduced motion, just appear
      const show = (counts: Counts) => {
        cancelAnimationFrame(frame);
        if (!counts.working) {
          liveEls.forEach((live) => (live.hidden = true));
          return;
        }
        setFlaps(counts.working);
        if (liveEls[0].hidden || reduceMotion) {
          render(counts);
          liveEls.forEach((live) => (live.hidden = false));
          if (dropWanted) dropBoard();
          return;
        }
        const from = onScreen;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / COUNT_MS, 1);
          const eased = 1 - (1 - progress) ** 3;
          const at = (key: keyof Counts) => Math.round(from[key] + (counts[key] - from[key]) * eased);
          render({ working: at("working"), benched: at("benched") });
          if (progress < 1) frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      };

      let retries = 0;
      const connect = () => {
        const socket = new WebSocket(`${LIVE_URL.replace(/^http/, "ws")}/ws`);
        socket.addEventListener("open", () => (retries = 0));
        socket.addEventListener("message", (event) => show(JSON.parse(event.data)));
        // A failed connection closes too
        socket.addEventListener("close", () =>
          setTimeout(connect, RETRY_DELAYS_MS[Math.min(retries++, RETRY_DELAYS_MS.length - 1)]),
        );
      };
      if (LIVE_URL) connect();

      const liveBar = document.querySelector<HTMLElement>(".live-bar");
      if (liveBar) {
        const slideUpOnScroll = () => liveBar.classList.toggle("is-shown", window.scrollY > 240);
        window.addEventListener("scroll", slideUpOnScroll, { passive: true });
        slideUpOnScroll();
      }
    }

    // The hero's Slack notification waits until the visitor scrolls a little
    const slackNotification = document.querySelector(".hero-notification-slack");
    const showSlackNotificationAfterScroll = () => {
      if (window.scrollY < 40) return;
      slackNotification?.classList.add("is-shown");
      window.removeEventListener("scroll", showSlackNotificationAfterScroll);
    };
    window.addEventListener("scroll", showSlackNotificationAfterScroll, { passive: true });
    showSlackNotificationAfterScroll();

    // Keep each roster's members popover on screen by nudging it left when it would overflow
    document.querySelectorAll<HTMLElement>(".rosters li").forEach((tile) => {
      const popover = tile.querySelector<HTMLElement>(".roster-members");
      if (!popover) return;
      // Measured a frame later, once the hover style has made the popover visible. Layout sizes (offsetLeft and
      // offsetWidth) ignore the fade-in's slide.
      const keepPopoverOnScreen = () =>
        requestAnimationFrame(() => {
          popover.style.marginLeft = "0px";
          const popoverRight = tile.getBoundingClientRect().left + popover.offsetLeft + popover.offsetWidth;
          const overflow = popoverRight - (document.documentElement.clientWidth - 16);
          if (overflow > 0) popover.style.marginLeft = `${-overflow}px`;
        });
      tile.addEventListener("pointerenter", keepPopoverOnScreen);
      tile.addEventListener("focusin", keepPopoverOnScreen);
    });

    // A tap opens a roster's popover by focusing its tile, and phones don't blur it on a tap elsewhere. Close the open
    // popover on any tap; on a tap on the open tile itself, preventDefault stops the tap from focusing it again.
    document.addEventListener("pointerdown", (event) => {
      const openTile = document.activeElement;
      if (!(openTile instanceof HTMLElement) || !openTile.matches(".rosters li")) return;
      if (openTile.contains(event.target as Node)) event.preventDefault();
      openTile.blur();
    });
    // The "Build on it" dashboard behaves like one polling GET /v1/stats every few seconds, so it only animates what
    // the API gives it: time since each agent was drafted ticks up, and some polls bring news: an agent's task changes,
    // or an agent goes back to the bench and someone from the bench is drafted in their place.
    const dashboard = document.querySelector<HTMLElement>(".dashboard");
    if (dashboard) {
      const POLL_MS = 4000;
      const tasks: string[] = JSON.parse(dashboard.dataset.tasks ?? "[]");
      const repos = ["acme/web", "acme/api", "acme/billing"];
      const cards = [...dashboard.querySelectorAll<HTMLElement>(".agent-card")];
      const bench = dashboard.querySelector<HTMLElement>(".dashboard-bench")!;
      const updated = dashboard.querySelector<HTMLElement>(".dashboard-updated")!;
      const pick = <T,>(items: T[]) => items[Math.floor(Math.random() * items.length)];
      const part = (card: HTMLElement, name: string) => card.querySelector<HTMLElement>(`.agent-${name}`)!;

      const draftedAt = new Map(cards.map((card) => [card, Date.now() - Number(card.dataset.minutes) * 60_000]));
      const formatElapsed = (ms: number) => {
        const seconds = Math.floor(ms / 1000);
        const pad = (n: number) => String(n).padStart(2, "0");
        const minutes = Math.floor(seconds / 60);
        return minutes >= 60
          ? `${Math.floor(minutes / 60)}:${pad(minutes % 60)}:${pad(seconds % 60)}`
          : `${minutes}:${pad(seconds % 60)}`;
      };

      // Restart a one-shot CSS animation
      const replay = (element: HTMLElement, className: string) => {
        element.classList.remove(className);
        void element.offsetWidth;
        element.classList.add(className);
      };

      const changeTask = (card: HTMLElement) => {
        const current = new Set(cards.map((other) => part(other, "task").textContent));
        part(card, "task").textContent = pick(tasks.filter((task) => !current.has(task)));
        replay(card, "is-updated");
      };

      // The bench is in draft order, so the agent drafted into the card is the first one: the free member drafted
      // least recently, never-drafted first, as rostr does. The card's agent was just drafted, so they go back to the
      // end of the bench.
      const swapAgent = (card: HTMLElement) => {
        const incoming = bench.querySelector<HTMLElement>(".chip:not(.is-leaving)");
        if (!incoming) return;
        const [emoji, ...name] = (incoming.textContent ?? "").split(" ");
        const released = document.createElement("span");
        released.className = "chip";
        released.textContent = `${part(card, "emoji").textContent} ${part(card, "name").textContent}`;

        incoming.classList.add("is-leaving");
        card.classList.add("is-leaving");
        setTimeout(() => {
          incoming.remove();
          bench.append(released);
          replay(released, "is-new");

          const current = new Set(cards.map((other) => part(other, "task").textContent));
          part(card, "emoji").textContent = emoji;
          part(card, "name").textContent = name.join(" ");
          part(card, "task").textContent = pick(tasks.filter((task) => !current.has(task)));
          part(card, "repo").textContent = pick(repos);
          draftedAt.set(card, Date.now());
          card.classList.remove("is-leaving");
          replay(card, "is-updated");
        }, 300);
      };

      let lastPoll = Date.now();
      let polls = 0;
      const tick = () => {
        for (const card of cards) part(card, "time").textContent = formatElapsed(Date.now() - draftedAt.get(card)!);
        const ago = Math.round((Date.now() - lastPoll) / 1000);
        updated.textContent = ago < 1 ? "Updated just now" : `Updated ${ago}s ago`;
      };
      // Every other poll has news, alternating between a task change and a draft
      const poll = () => {
        lastPoll = Date.now();
        polls++;
        replay(updated, "is-polling");
        if (polls % 4 === 1) changeTask(pick(cards));
        if (polls % 4 === 3) swapAgent(pick(cards));
        tick();
      };
      tick();
      setInterval(tick, 1000);
      setInterval(poll, POLL_MS);
    }
  </script>

  <!-- Live: agents at work in split-flap digits, and on the bench, on a board hanging from the top of the screen by a
       wire, right of the page; it drops in a second after load, or as soon as the visitor scrolls -->
  <div class="live-board" hidden>
    <span class="live-board-shadow" aria-hidden="true"></span>
    <div class="live-board-rig">
      <span class="live-board-wire" aria-hidden="true"></span>
      <div class="live-board-sign">
        <span class="live-board-light" aria-hidden="true"></span>
        <span class="flaps" role="img"></span>
        <span class="live-board-label">agents at work</span>
        <span class="live-board-bench"><b class="live-benched"></b> on the bench</span>
      </div>
    </div>
  </div>

  <!-- Live: agents drafted across all of rostr, in a bar that slides up from the bottom once the visitor scrolls -->
  {SHOW_LIVE_BAR && (
    <div class="live-bar" hidden>
      <div class="live-bar-track">
        {[0, 1, 2, 3, 4, 5].map(() => (
          <span class="live-bar-item">
            <span class="live-bar-badge">LIVE</span>
            <span><b class="live-drafted"></b> <span class="live-drafted-label"></span> out of <b class="live-total"></b></span>
          </span>
        ))}
      </div>
    </div>
  )}
</Layout>
