---
import { Code } from "astro-expressive-code/components";
import Layout from "../layouts/Layout.astro";
import { ANSI_DIM, ANSI_RESET, toTerminalText } from "../terminal";
import ClaudeIcon from "../assets/claude.svg";
import { PRESET_ROSTERS } from "../data/rosters";

// The home page grid shows 10 regular presets, the featured mix, and a "Your own" tile; /rosters shows them all
const HOME_GRID_ROSTERS = [
  ...PRESET_ROSTERS.filter((roster) => !("featuredTag" in roster)).slice(0, 10),
  ...PRESET_ROSTERS.filter((roster) => "featuredTag" in roster),
];

// On phones the grid is trimmed to these presets plus the "Your own" tile
const MOBILE_GRID_ROSTER_IDS = ["fellowship", "hogwarts", "dunder-mifflin", "billionaires"];

// Every member of every preset roster, for the hero's flipping name
const HERO_FLIPPER_NAMES = [...new Set(PRESET_ROSTERS.flatMap((roster) => [...roster.aTeam, ...roster.bTeam]))];
// What the hero's flipping agent is on: "🧙 Gandalf is on CI."
// Kept short so the status fits on the same line as "Remember who's doing what." on desktop
const HERO_STATUS_TASKS = ["CI", "billing", "auth", "the docs", "the API", "dark mode", "tests", "search", "perf", "deploys", "logging", "caching"];

const SETUP_PROMPT = "Set up rostr for me by following the instructions at https://getrostr.sh";

// The hero's `rostr list --all`: one roster for work and one for side projects
const HERO_ROSTERS = [
  {
    name: "work",
    drafted: [
      { emoji: "🧙", name: "Gandalf", task: "Fix auth redirect loop", where: "acme/api", since: "12m" },
      { emoji: "💍", name: "Frodo", task: "Flaky e2e tests on CI", where: "acme/web", since: "3m" },
      { emoji: "🌱", name: "Samwise", task: "Migrate billing to Stripe v3", where: "acme/billing", since: "1h" },
    ],
    idle: ["Aragorn", "Legolas", "Gimli", "Boromir", "Merry", "Pippin"],
  },
  {
    name: "side",
    drafted: [
      { emoji: "🐐", name: "Jordan", task: "Port the recipe app to iOS", where: "me/recipes", since: "40m" },
      { emoji: "👑", name: "LeBron", task: "Add dark mode to the blog", where: "me/blog", since: "5m" },
    ],
    idle: ["Kobe", "Magic", "Bird", "Curry", "Shaq", "Kareem"],
  },
];

// Short summaries of the CLI's command groups; each card links to that group in the CLI docs
const COMMAND_GROUP_CARDS = [
  {
    href: "/cli#roster-commands",
    title: "🎯 Roster commands",
    description: "Assemble rosters, give projects their own, see who's on what, and edit your cast.",
    commands: ["assemble", "link", "list", "edit", "presets", "disband"],
  },
  {
    href: "/cli#agent-commands",
    title: "🤖 Agent commands",
    description: "Your hooks run these for you. Draft by hand with /draft.",
    commands: ["agent draft", "agent release", "agent task"],
  },
  {
    href: "/cli#settings",
    title: "⚙️ Settings",
    description: "Emoji, auto-draft, cloud, and your default roster.",
    commands: ["config"],
  },
];


// The "Build on it" dashboard example uses the Smash Bros roster
const DASHBOARD_ROSTER = PRESET_ROSTERS.find((roster) => roster.id === "smash-bros")!;
const DASHBOARD_MEMBERS = [
  { emoji: "🍄", name: "Mario", task: "Ship the onboarding redesign", where: "acme/web", since: "25m" },
  { emoji: "🗡️", name: "Link", task: "Fix flaky checkout test", where: "acme/api", since: "8m" },
  { emoji: "⭐", name: "Kirby", task: "Upgrade the image pipeline", where: "acme/api", since: "2h" },
  { emoji: "🚀", name: "Samus", task: "Add rate limiting to the API", where: "cloud", since: "50m" },
];
const DASHBOARD_IDLE_CHIPS = [...DASHBOARD_ROSTER.aTeam, ...DASHBOARD_ROSTER.bTeam].filter(
  (member) => !DASHBOARD_MEMBERS.some((working) => member.endsWith(` ${working.name}`)),
);

// Terminal examples, rendered with Expressive Code
const HERO_LIST_EXAMPLE = toTerminalText(
  [
    "$ rostr list",
    ...HERO_ROSTERS.flatMap((roster, index) => [
      ...(index > 0 ? [""] : []),
      `${ANSI_DIM}${roster.name} roster${ANSI_RESET}`,
      ...roster.drafted.map(
        (member) => `${member.emoji} ${member.name.padEnd(8)} ${member.task.padEnd(30)} ${member.where.padEnd(13)} ${member.since}`,
      ),
      `${ANSI_DIM}idle: ${roster.idle.join(", ")}${ANSI_RESET}`,
    ]),
  ].join("\n"),
);
// Command-only blocks use plain shell (no "$"), so their copy buttons copy runnable commands
const INSTALL_EXAMPLE = `curl -fsSL https://getrostr.sh/install | sh
rostr assemble`;
const INSTALL_SCRIPT_SOURCE = "https://github.com/piazzatron/rostr/blob/main/site/public/install";
const API_EXAMPLE = `curl https://api.getrostr.sh/v1/rosters \\
  -H "Authorization: Bearer $ROSTR_TOKEN"`;
// Pasted to an agent so it can write the ~15 lines that derive the auth token and decrypt tasks and repos
const DECRYPT_PROMPT = `Build me a dashboard of my rostr agents using the rostr API. My rostr key is in ROSTR_KEY: "rostr_sk_" followed by 32 bytes as base64url. Derive two 32-byte keys from those bytes with HKDF-SHA256 (no salt): info "auth" is the bearer token (send it base64url-encoded), and info "encrypt" is an AES-256-GCM key. Fetch GET https://api.getrostr.sh/v1/rosters with that token. Each drafted agent's task and repo are base64: the first 12 bytes are the nonce, and the rest is the ciphertext and tag.`;

const LIST_JSON_EXAMPLE = `{
  "rosters": [
    {
      "name": "work",
      "drafted": [
        {
          "name": "Gandalf",
          "emoji": "🧙",
          "team": "A",
          "task": "Fix auth redirect loop",
          "repo": "acme/api",
          "draftedAt": "2026-10-19T03:12:00Z"
        }
      ],
      "idle": [
        {
          "name": "Aragorn",
          "emoji": "👑",
          "team": "A"
        }
      ]
    }
  ]
}`;
---

<Layout
  title="rostr: give your agents names"
  description="rostr gives each of your coding agents a name, so you can remember who's doing what. Works with Claude Code and Codex."
>
    <!-- Hero -->
    <section class="hero">
      <h1>Give your agents names.</h1>
      <p class="hero-subtitle">
        Remember who's doing what.{" "}
        <span class="hero-status" aria-hidden="true">
          <span class="name-flipper" data-names={JSON.stringify(HERO_FLIPPER_NAMES)}>
            <span><span class="status-emoji">🧙</span>Gandalf</span>
          </span>{" "}
          <span class="hero-status-task">
            is on <span class="task-text" data-tasks={JSON.stringify(HERO_STATUS_TASKS)}>auth</span>.
          </span>
        </span>
      </p>
      <p class="lede">
        rostr automatically drafts a name for each agent from a stable roster you set. It works across all your favorite
        harnesses in local and cloud sessions.
      </p>
      <p class="cta-title">Get started: paste this into your agent</p>
      <div class="cta">
        <button class="copy copy-hero" data-copy={SETUP_PROMPT}>
          <span class="copy-text">“{SETUP_PROMPT}”</span>
          <span class="copy-label">Copy</span>
        </button>
      </div>
      <a class="cta-alt" href="#install">or run the install script ↓</a>

      <div class="hero-terminal">
        <Code code={HERO_LIST_EXAMPLE} lang="ansi" frame="terminal" />
        <div class="notification scene-notification is-waiting hero-notification hero-notification-claude">
          <span class="notification-icon"><ClaudeIcon aria-hidden="true" /></span>
          <div class="notification-text">
            <div class="notification-top"><strong>🌱 Samwise · Migrate billing</strong><span>now</span></div>
            <p>Claude is waiting for your input</p>
          </div>
        </div>
        <div class="notification hero-notification hero-notification-slack">
          <span class="notification-icon notification-icon-slack" aria-hidden="true">#</span>
          <div class="notification-text">
            <div class="notification-top"><strong>🧙 Gandalf</strong><span>now</span></div>
            <p>Needs your input on the auth redirect loop</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section" id="how-it-works">
      <h2>How it works</h2>
      <p class="section-lede">rostr is a small <a class="accent-link" href="/cli">CLI</a> plus a skill that teaches your agent how to use it.</p>
      <ol class="steps">
        <li>
          <h3>Assemble your roster</h3>
          <p>Run <code>rostr assemble</code>, or just ask your agent to do it for you.</p>
        </li>
        <li>
          <h3>Sessions draft agents</h3>
          <p>
            When a session starts, a hook drafts the next available name and tells the agent its identity.
          </p>
        </li>
        <li>
          <h3>Done? Back to the bench</h3>
          <p>
            When a session ends, its agent is free for the next one.
          </p>
        </li>
      </ol>

      <p class="section-lede">The commands, at a glance:</p>
      <div class="group-cards">
        {COMMAND_GROUP_CARDS.map((card) => (
          <a class="card group-card" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <span class="group-card-commands">{card.commands.map((command) => <code>{command}</code>)}</span>
          </a>
        ))}
      </div>
      <p class="docs-link"><a href="/cli">Read the full CLI docs →</a></p>
    </section>

    <!-- Why -->
    <section class="section">
      <h2>Why anthropomorphize your agents?</h2>
      <p class="section-lede">A bunch of reasons, it turns out.</p>
      <ol class="value-list">
        <li>
          <h3>Triage notifications</h3>
          <p>Know who's asking before you click, just by referencing an emoji.</p>
        </li>
        <li>
          <h3>Exploit your human psychology</h3>
          <p>
            Your brain doesn't want to remember 25 abstract "work streams". It may remember that Aragorn and Sauron are
            tag-teaming the CI fix.
          </p>
        </li>
        <li>
          <h3>Better async</h3>
          <p>
            When an agent reaches out on Slack, a PR, or email, it signs with its name, so you know exactly which session
            to open.
          </p>
        </li>
        <li>
          <h3>Help agents find each other</h3>
          <p>Names give agents a way to address each other. Point one at another by name and it knows who you mean.</p>
        </li>
        <li>
          <h3>It's funny</h3>
          <p>Gandalf fixing your CSS is objectively funnier than session 4f2a fixing your CSS.</p>
        </li>
      </ol>
    </section>

    <!-- Rosters -->
    <section class="section">
      <h2>Squad up</h2>
      <p class="section-lede">
        Pick a pre-built roster or assemble your own. Every roster has an A team and a B team (hover to meet them), and
        every agent gets its own emoji, which you can turn off if that's not your thing.
      </p>
      <ul class="rosters">
        {HOME_GRID_ROSTERS.map((roster) => (
          <li
            tabindex="0"
            class:list={{
              "roster-featured": "featuredTag" in roster,
              "roster-desktop-only": !MOBILE_GRID_ROSTER_IDS.includes(roster.id),
            }}
          >
            {"featuredTag" in roster && <span class="roster-tag">{roster.featuredTag}</span>}
            <span class="roster-emoji">{roster.emoji}</span>
            <span>
              <strong>{roster.name}</strong>
              <small>{roster.source}</small>
            </span>
            <div class="roster-teams" role="tooltip">
              <b>A team</b>
              <div class="chips">
                {roster.aTeam.map((member, index) => <span class="chip chip-a" style={`--i: ${index}`}>{member}</span>)}
              </div>
              <b>B team</b>
              <div class="chips">
                {roster.bTeam.map((member, index) => <span class="chip" style={`--i: ${index + 6}`}>{member}</span>)}
              </div>
            </div>
          </li>
        ))}
        <li class="roster-custom" tabindex="0">
          <span class="roster-emoji">✏️</span>
          <span>
            <strong>Your own</strong>
            <small>Any list of names</small>
          </span>
          <div class="roster-teams" role="tooltip">
            <b>A team</b>
            <div class="chips"><span class="chip chip-a" style="--i: 0">⭐ Your six favorites</span></div>
            <b>B team</b>
            <div class="chips"><span class="chip" style="--i: 1">🪑 Everyone else</span></div>
          </div>
        </li>
      </ul>
      <p class="docs-link">
        <a href="/rosters">See all pre-built rosters + submit your own →</a>
      </p>

      <div class="cards team-cards">
        <div class="card">
          <h3>🅰️ A team, B team</h3>
          <p>
            Twenty names are too many to get to know, so every roster has a small A team: six by default, picked
            with <code>rostr edit</code>. rostr always drafts from the A team first and only calls up the B team when all your
            starters are busy.
          </p>
        </div>
        <div class="card">
          <h3>📁 One roster for work, one for side projects</h3>
          <p>
            Keep as many rosters as you like and give each project its own with <code>rostr link</code>. The Fellowship
            works your day job and the NBA Legends work your side projects, so when Jordan pings you, you know which
            one it is before you read a word.
          </p>
        </div>
      </div>
    </section>

    <!-- Local and cloud -->
    <section class="section" id="local-and-cloud">
      <h2>Local and Cloud Rosters</h2>
      <dl class="modes">
        <div>
          <dt>💻 Local</dt>
          <dd>The default. Nothing leaves your machine.</dd>
        </div>
        <div>
          <dt>☁️ Cloud</dt>
          <dd>
            For when you also run agents in the cloud. Every session shares one roster, with no account, just a key. Task
            and repo metadata are end-to-end encrypted. <a class="accent-link" href="/privacy"
              >Learn more about privacy →</a
            >
          </dd>
        </div>
      </dl>
      <p class="modes-note">
        Choose during <code>rostr assemble</code>, or move to the cloud later with <code>rostr config cloud on</code>.
      </p>
    </section>

    <!-- Build on it -->
    <section class="section">
      <h2>Build on it</h2>
      <p class="section-lede">
        Use the output of <code>rostr list --json</code> or the list API endpoint to build your own dashboards,
        monitoring, and integrations.
      </p>

      <figure class="dashboard" aria-label="Example team dashboard built on rostr list --json">
        <div class="dashboard-bar">
          <span></span><span></span><span></span>
          <span class="dashboard-url">localhost:3000</span>
        </div>
        <div class="dashboard-body">
          <div class="dashboard-header">
            <strong>{DASHBOARD_ROSTER.emoji} app</strong>
            <span>{DASHBOARD_MEMBERS.length} working · {DASHBOARD_IDLE_CHIPS.length} on the bench</span>
          </div>
          <div class="dashboard-grid">
            {DASHBOARD_MEMBERS.map((member) => (
              <div class="agent-card">
                <div class="agent-top">
                  <span class="agent-emoji">{member.emoji}</span>
                  <strong>{member.name}</strong>
                  <span class="status-dot" aria-label="working"></span>
                </div>
                <p class="agent-task">{member.task}</p>
                <div class="agent-meta">
                  <span>{member.where}</span>
                  <span>{member.since}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="dashboard-bench">
            <span class="bench-label">On the bench</span>
            {DASHBOARD_IDLE_CHIPS.map((member) => <span class="chip">{member}</span>)}
          </div>
        </div>
        <figcaption>A team dashboard built on <code>rostr list --json</code>.</figcaption>
      </figure>
      <div class="cards build-cards">
        <div class="card">
          <h3>💻 On your machine</h3>
          <Code code="rostr list --json" lang="sh" />
          <p class="build-note">Local or cloud mode. Tasks and repos come back decrypted.</p>
          <h3 class="build-subhead">🌐 On the web</h3>
          <Code code={API_EXAMPLE} lang="sh" />
          <p class="build-note">
            Cloud mode. Get your token with <code>rostr config key --token</code>. Rosters and who's drafted come back
            readable; tasks and repos stay end-to-end encrypted.
          </p>
          <button class="copy-link" data-copy={DECRYPT_PROMPT}>
            <span class="copy-label">📋 Copy a prompt that teaches your agent to decrypt them</span>
          </button>
        </div>
        <div class="card">
          <h3>Response</h3>
          <Code code={LIST_JSON_EXAMPLE} lang="json" />
        </div>
      </div>

    </section>

    <!-- Why I built this -->
    <section class="section narrow" id="why-i-built-this">
      <h2>Why I built this</h2>
      <p>A few threads led to rostr:</p>
      <ol class="threads">
        <li>
          Once you adopt a long-running, async agent workflow, your agents need a way to <strong
            >reach you when they get stuck</strong
          >. And whatever tool you build or adopt for this, you should be able to tell at a glance which session is
          reaching out.
        </li>
        <li>
          Stable agent identities seem like a useful primitive! Regardless of what harness or agent management tool you
          use, you should be able to easily port your team. I was inspired by the named agents in <a href="https://github.com/gastownhall/gastown">Gas Town</a>,
          but without the whole kitchen sink.
        </li>
        <li>
          rostr is an experiment in exercising some restraint with agents. It's tempting to spin up countless sessions on
          experimental workstreams, get exhausted, and then lose context picking your work back up the next morning. A
          fixed team might nudge you to bite off a more human-manageable amount of work and prioritize around your
          team's size, the way an EM does.
        </li>
      </ol>
    </section>

    <!-- Install -->
    <section class="section" id="install">
      <h2>Install</h2>
      <div class="cards">
        <div class="card">
          <h3>Ask your agent</h3>
          <p>
            Point Claude Code or Codex at this page and it will install rostr, set up the hooks and skill, and help you
            pick a roster. Agents: your setup steps are at <a href="/setup.md">getrostr.sh/setup.md</a>.
          </p>
          <button class="copy copy-block" data-copy={SETUP_PROMPT}>
            <span class="copy-text">“{SETUP_PROMPT}”</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <div class="card">
          <h3>Run the install script</h3>
          <p>
            Install rostr, then assemble your roster. It walks you through the choices and sets up the
            hooks. <a href={INSTALL_SCRIPT_SOURCE}>See the script</a>.
          </p>
          <Code code={INSTALL_EXAMPLE} lang="sh" />
          <p class="build-note">
            On a Mac with Homebrew, <code>brew install piazzatron/tap/rostr</code> works too.
          </p>
        </div>
      </div>
      <p class="install-cloud">
        <strong>Cloud sessions</strong> (Claude Code on the web, Codex cloud): add the install line to your environment's
        setup script, set <code>ROSTR_KEY</code> to the key from <code>rostr config key</code>, and
        allow <code>github.com</code> and <code>api.getrostr.sh</code> in its network settings.
      </p>
    </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const label = button.querySelector(".copy-label");
        if (!label) return;
        const original = label.textContent;
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = original), 1500);
      });
    });

    // Every 1.3s the hero's status line ("🧙 Gandalf is on CI.") deals a new agent and task. The name springs in from
    // below while the old one slides out; the task just flicks over. With reduced motion both simply swap.
    const flipper = document.querySelector<HTMLElement>(".name-flipper");
    const taskText = document.querySelector<HTMLElement>(".task-text");
    if (flipper && taskText) {
      const allNames: string[] = JSON.parse(flipper.dataset.names ?? "[]");
      const tasks: string[] = JSON.parse(taskText.dataset.tasks ?? "[]");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // A name like "🧙 Gandalf" renders as the emoji in its own span, which sets a tighter gap than a monospace space
      const fillName = (element: HTMLElement, name: string) => {
        const [emoji, ...rest] = name.split(" ");
        const emojiSpan = document.createElement("span");
        emojiSpan.className = "status-emoji";
        emojiSpan.textContent = emoji;
        element.replaceChildren(emojiSpan, rest.join(" "));
      };

      // Keep only the names that fit between where the name starts and the end of the line, leaving room for the
      // longest " is on <task>." (on phones the task wraps onto its own line, so it needs no room). Measured once at load.
      const line = document.querySelector(".hero-subtitle") as HTMLElement;
      const taskPart = taskText.parentElement as HTMLElement;
      const probe = document.createElement("span");
      probe.style.cssText = "position: absolute; visibility: hidden; white-space: nowrap";
      flipper.parentElement?.append(probe);
      const widthOf = (text: string) => {
        probe.textContent = text;
        return probe.offsetWidth;
      };
      const nameWidth = (name: string) => {
        fillName(probe, name);
        return probe.offsetWidth;
      };
      const nameStart = flipper.getBoundingClientRect().left - line.getBoundingClientRect().left;
      const taskPartWidth =
        getComputedStyle(taskPart).display === "block" ? 0 : Math.max(...tasks.map((task) => widthOf(` is on ${task}.`)));
      const names = allNames.filter((name) => nameStart + nameWidth(name) + taskPartWidth <= line.clientWidth);
      probe.remove();

      // Deal names and tasks from shuffled decks so neither repeats until all have been shown
      const makeDealer = (items: string[]) => {
        let deck: string[] = [];
        return () => {
          if (deck.length === 0) deck = [...items].sort(() => Math.random() - 0.5);
          return deck.pop() ?? "";
        };
      };
      const dealName = makeDealer(names);
      const dealTask = makeDealer(tasks);

      // The name slot is as wide as its current name, so " is on" sits right after it
      flipper.style.width = `${(flipper.firstElementChild as HTMLElement).offsetWidth}px`;

      setInterval(() => {
        const outgoing = flipper.lastElementChild as HTMLElement;
        const incoming = document.createElement("span");
        fillName(incoming, dealName());
        flipper.append(incoming);
        flipper.style.width = `${incoming.offsetWidth}px`;
        taskText.textContent = dealTask();

        if (reduceMotion) {
          outgoing.remove();
          return;
        }
        outgoing.classList.add("is-leaving");
        outgoing.addEventListener("animationend", () => outgoing.remove(), { once: true });
        incoming.classList.add("is-entering");
        taskText.classList.remove("is-swapping");
        void taskText.offsetWidth; // restart the task's animation
        taskText.classList.add("is-swapping");
      }, 1300);
    }

    // The hero's Slack notification waits until the visitor scrolls a little
    const slackNotification = document.querySelector(".hero-notification-slack");
    const showSlackNotificationAfterScroll = () => {
      if (window.scrollY < 40) return;
      slackNotification?.classList.add("is-shown");
      window.removeEventListener("scroll", showSlackNotificationAfterScroll);
    };
    window.addEventListener("scroll", showSlackNotificationAfterScroll, { passive: true });
    showSlackNotificationAfterScroll();

    // Keep each roster's A team / B team popover on screen by nudging it left when it would overflow
    document.querySelectorAll<HTMLElement>(".rosters li").forEach((tile) => {
      const popover = tile.querySelector<HTMLElement>(".roster-teams");
      if (!popover) return;
      // Measured a frame later, once the hover style has made the popover visible. Layout sizes (offsetLeft and
      // offsetWidth) ignore the pop-in animation's scale and rotation.
      const keepPopoverOnScreen = () =>
        requestAnimationFrame(() => {
          popover.style.marginLeft = "0px";
          const popoverRight = tile.getBoundingClientRect().left + popover.offsetLeft + popover.offsetWidth;
          const overflow = popoverRight - (document.documentElement.clientWidth - 16);
          if (overflow > 0) popover.style.marginLeft = `${-overflow}px`;
        });
      tile.addEventListener("pointerenter", keepPopoverOnScreen);
      tile.addEventListener("focusin", keepPopoverOnScreen);
    });

    // A tap opens a roster's popover by focusing its tile, and phones don't blur it on a tap elsewhere. Close the open
    // popover on any tap; on a tap on the open tile itself, preventDefault stops the tap from focusing it again.
    document.addEventListener("pointerdown", (event) => {
      const openTile = document.activeElement;
      if (!(openTile instanceof HTMLElement) || !openTile.matches(".rosters li")) return;
      if (openTile.contains(event.target as Node)) event.preventDefault();
      openTile.blur();
    });
  </script>
</Layout>
