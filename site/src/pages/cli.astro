---
import { Code } from "astro-expressive-code/components";
import Layout from "../layouts/Layout.astro";
import Rostr from "../components/Rostr.astro";
import { toTerminalText } from "../terminal";
import { PRESET_ROSTERS } from "../data/rosters";

interface CommandDoc {
  id: string;
  /** Shown after "rostr" in the heading and quick links, e.g. "link / unlink" or "draft / release". Defaults to the id. */
  heading?: string;
  usage: string;
  summary: string;
  options?: { flag: string; description: string }[];
  example: string;
  /** A short label shown as a pill next to the heading. */
  badge?: string;
  /** A highlighted callout shown under the summary. */
  note?: string;
}

interface CommandGroup {
  id: string;
  emoji: string;
  title: string;
  lede: string;
  commands: CommandDoc[];
}

const COMMAND_GROUPS: CommandGroup[] = [
  {
    id: "roster-commands",
    emoji: "🎯",
    title: "Roster commands",
    lede: "Set up and manage your rosters.",
    commands: [
      {
        id: "assemble",
        badge: "⭐ The only one you need",
        usage:
          "rostr assemble [<roster>] [--preset <id> [--size <n>|all] | --names <list>] [--emoji on|off|only] [--cloud] [--no-auto-draft] [--link]",
        summary:
          "Interactive setup: answer a few questions and you're done. It's the only command you need to run, and your agent can run it for you with flags.",
        options: [
          { flag: "--preset <id>", description: "Skip the preset question. See them all with rostr presets." },
          { flag: "--size <n>|all", description: "How many of the preset's members are on your team, from the top of its list. Defaults to 16; all takes everyone. Only with --preset." },
          { flag: "--names <list>", description: "Use your own comma-separated names, in draft order, with an emoji in front if you like. Names without an emoji get a random one." },
          { flag: "--emoji on|off|only", description: "How agents show up. Defaults to on." },
          { flag: "--cloud", description: "Keep everything on the rostr API. Only for your first roster; after that, use rostr cloud on." },
          { flag: "--no-auto-draft", description: "Don't draft sessions automatically; use /draft instead." },
          { flag: "--link", description: "Use the new roster for the repo you're in. The wizard asks this when you're in a repo." },
        ],
        example: `$ rostr assemble
✔ Pick a preset · 💍 The Fellowship
✔ How big is your team? · 6
✔ Name your roster · work
✔ Emoji · On (🧙 Gandalf)
✔ Where should rostr live? · This machine
✔ Draft every new session automatically? · Yes
✔ Claude Code: hooks, skill, and /draft installed
✔ Codex: hooks and skill installed
💍 Assembled a roster named work. Start a new session to get drafted

$ rostr assemble side --names "🧮 Ada, Grace, Linus, Margaret, Ken, Barbara"
✏️ Assembled a roster named side with 6 members
   🧮 Ada, 🦋 Grace, 🐧 Linus, 🚀 Margaret, 🧵 Ken, 🌻 Barbara`,
      },
      {
        id: "link",
        heading: "link / unlink",
        usage: "rostr link [<roster>] [--repo <owner/repo>]\nrostr unlink [--repo <owner/repo>]",
        summary:
          "Pick which roster your project uses, or unlink it to go back to your default roster. Run rostr link on its own to see which roster this project uses and change it.",
        note:
          "Worth it when you want to tell projects apart at a glance: give your side projects the NBA Legends, and Jordan can only mean a side project.",
        options: [{ flag: "--repo <owner/repo>", description: "Link or unlink a repo other than the current one." }],
        example: `$ cd ~/code/recipes
$ rostr link
✔ me/recipes uses the work roster (your default). Pick one · side
🏀 Linked me/recipes to the side roster

$ rostr link side --repo me/blog
🏀 Linked me/blog to the side roster

$ rostr unlink
Unlinked me/recipes. It now uses your default roster, work`,
      },
      {
        id: "stats",
        usage: "rostr stats [<roster>, ...] [--json]",
        summary: "See who's working on what, who's resting, and who's on the bench, across all your rosters. Name rosters to see just those.",
        options: [{ flag: "--json", description: "Print the result as JSON." }],
        example: `$ rostr stats
work roster
🧙 Gandalf   Fix auth redirect loop         acme/api      12m
💍 Frodo     Flaky e2e tests on CI          acme/web      3m
🌱 Samwise   Migrate billing to Stripe v3   acme/billing  1h
bench: Aragorn, Legolas, Gimli, Boromir, Merry, Pippin

side roster
🐐 Jordan    Port the recipe app to iOS     me/recipes    40m
bench: LeBron, Kobe, Magic, Bird, Curry, Shaq

$ rostr stats side
side roster
🐐 Jordan    Port the recipe app to iOS     me/recipes    40m
bench: LeBron, Kobe, Magic, Bird, Curry, Shaq`,
      },
      {
        id: "edit",
        usage: "rostr edit [<roster>]",
        summary: "Add, rename, and remove a roster's members and change their emoji, in a full-screen editor. To swap in a whole new cast, run rostr assemble and replace it.",
        example: `$ rostr edit work
Saved the work roster.`,
      },
      {
        id: "presets",
        usage: "rostr presets [--json]",
        summary: "See all the pre-built rosters you can pass to --preset. They're also on the rosters page, with all their members.",
        options: [{ flag: "--json", description: "Print every preset as JSON, with all its members in draft order." }],
        example:
          "$ rostr presets\n" +
          PRESET_ROSTERS.map((roster) => `${roster.id.padEnd(16)} ${roster.emoji} ${roster.name} (${roster.source})`).join("\n"),
      },
      {
        id: "disband",
        usage: "rostr disband <roster> [--yes]",
        summary: "Delete a roster, after asking. Projects that used it fall back to your default, and if it was your default, your oldest other roster takes over.",
        options: [{ flag: "--yes", description: "Skip the question. Agents need this, since they can't answer it." }],
        example: `$ rostr disband work
✔ Disband work? 3 agents drafted, 1 linked project · Yes
Disbanded work. side is now your default roster`,
      },
    ],
  },
  {
    id: "agent-commands",
    emoji: "🤖",
    title: "Agent commands",
    lede: "Your hooks, the rostr skill, and the /draft slash command run these.",
    commands: [
      {
        id: "draft",
        heading: "draft / bench",
        badge: "⚙️ On session start and end",
        usage: "rostr draft [--task <description>] [--session <id>] [--json]\nrostr bench [<name>, ... | all] [--session <id>]",
        summary:
          "Draft the next free agent when a session starts, and send it back to the bench when the session ends. The same session always gets the same name back.",
        options: [
          { flag: "--task <description>", description: "What the agent is working on. Shown in rostr stats." },
          { flag: "--session <id>", description: "The session to draft or bench for. The hooks pass this, and it defaults to ROSTR_SESSION, then the agent's own session ID." },
          { flag: "--json", description: "Print the drafted agent as JSON." },
        ],
        example: `$ rostr draft --task "Fix auth redirect loop"
🧙 Gandalf is on it: Fix auth redirect loop

$ rostr draft --json
{"name": "Gandalf", "emoji": "🧙", "roster": "work", "display": "🧙 Gandalf"}

$ rostr bench gandalf
Benched 🧙 Gandalf from the work roster.`,
      },
      {
        id: "task",
        heading: "task",
        usage: "rostr task [<name>] <description>",
        summary: "Set or change what an agent is working on. Your hooks set the first task from your first prompt.",
        options: [
          { flag: "--session <id>", description: "Set the task for whoever is drafted to this session. The hooks pass this, and it defaults to ROSTR_SESSION, then the agent's own session ID." },
        ],
        example: `$ rostr task "Migrate billing to Stripe v3"
🌱 Samwise is now on: Migrate billing to Stripe v3

$ rostr task samwise "Migrate billing to Stripe v3"
🌱 Samwise is now on: Migrate billing to Stripe v3`,
      },
    ],
  },
  {
    id: "settings",
    emoji: "⚙️",
    title: "Settings",
    lede: "Change anything you chose during assemble.",
    commands: [
      {
        id: "config",
        usage:
          "rostr config\nrostr config default <roster>\nrostr config emoji on|off|only [--roster <roster>]\nrostr config auto-draft on|off\nrostr config key [--token]",
        summary: "See and change your settings. Run it on its own to see them all.",
        options: [
          { flag: "default", description: "The roster projects use when they don't have a link." },
          { flag: "emoji", description: "How agents show up: on (🧙 Gandalf), off (Gandalf), or only (🧙). only needs every member to have a different emoji." },
          { flag: "auto-draft", description: "Draft new sessions automatically, or by hand with /draft. It's set per machine; ROSTR_AUTO_DRAFT=off turns it off in a cloud environment." },
          { flag: "key", description: "Print your rostr key, which puts a machine in cloud mode. There's no recovery, so keep it safe. --token prints the token for the API instead." },
        ],
        example: `$ rostr config
default      work
emoji        on
auto-draft   on
cloud        off

$ rostr config emoji only
🧙 Emoji only for work. Agents now show as: 🧙 · Fix auth redirect loop`,
      },
      {
        id: "cloud",
        usage: "rostr cloud on\nrostr cloud install",
        summary: "Keep your setup on the rostr API, so agents on every machine and in cloud sessions share one roster.",
        options: [
          { flag: "on", description: "Move your whole setup to the cloud, or join one with your key (which installs rostr's hooks on this machine too). Turn it on once, when you start using cloud agents. There's no going back to local." },
          { flag: "install", description: "Install rostr's hooks for Claude Code and Codex in a cloud environment. The install script runs this for you when ROSTR_KEY is set in your cloud environment." },
        ],
        example: `$ rostr cloud on
✔ New setup, or do you have a key? · New setup
☁️ Moved your setup to the cloud
   2 rosters, 3 project links, 4 active drafts
   Saved your rostr key to ~/.config/rostr/credentials
   Run rostr config key to see it, then set it as ROSTR_KEY in your cloud environments`,
      },
    ],
  },
];
---

<Layout
  title="rostr CLI"
  description="Every rostr command: roster commands, agent commands, and settings."
>
  <section class="docs-hero">
    <h1>CLI</h1>
    <p class="lede">
      <Rostr /> is a single program for macOS and Linux. Your hooks call it at the start and end of every session,
      and the <Rostr /> skill teaches your agent to use it too.
    </p>
    {COMMAND_GROUPS.map((group) => (
      <nav class="toc" aria-label={group.title}>
        <a class="toc-group" href={`#${group.id}`}>{group.emoji} {group.title}</a>
        <div class="toc-chips">
          {group.commands.map((command) => <a href={`#${command.id}`}><code>{command.heading ?? command.id}</code></a>)}
        </div>
      </nav>
    ))}
  </section>

  <section class="section">
    <h2>Concepts</h2>
    <dl class="concepts">
      <dt>Roster</dt>
      <dd>A named list of agents you can draft from, like your Fellowship or your Smash Bros.</dd>
      <dt>Drafting</dt>
      <dd>
        A roster's members are in draft order. Each session gets the free member drafted least recently: anyone who
        hasn't been drafted yet goes first, in roster order. When no one's free, it takes the name of whoever has been
        resting longest, or else a numbered copy like <code>🧙&nbsp;Gandalf&nbsp;2</code>.
      </dd>
      <dt>Team size</dt>
      <dd>
        A pre-built roster is a big cast to pick from. When you assemble one, your team is its first 16, or pick 4,
        8, or everyone. Then pick anyone else on that roster, or add your own, in the cast editor.
      </dd>
      <dt>Local or cloud</dt>
      <dd>
        Your whole setup lives in one place. Locally, everything is on disk. Once you turn on <a href="#config"
          >cloud mode</a
        >, everything lives on the <Rostr /> API at <code>api.getrostr.sh</code>, and every session, on your machine or in
        a cloud environment, drafts from there. Having a <Rostr /> key (saved by <code>rostr cloud on</code>, or set
        as <code>ROSTR_KEY</code>) is what puts a machine in cloud mode.
      </dd>
      <dt>Projects</dt>
      <dd>
        Each git repo can use its own roster. <Rostr /> identifies a project by its <code>origin</code> remote
        (<code>owner/repo</code>), so it's the same project on every machine and in every worktree.
      </dd>
      <dt>Sessions</dt>
      <dd>
        Your hooks get each session's ID from Claude Code or Codex and pass it to <Rostr />, so drafting, setting the first
        task, and releasing all happen without your agent doing anything. The start hook also
        sets <code>ROSTR_SESSION</code> in the session's shell, so any <Rostr /> command your agent runs knows which session
        it's in.
      </dd>
      <dt>Which roster gets drafted</dt>
      <dd>
        The <code>--roster</code> flag on agent commands if you pass one, then the project's linked roster,
        then your default. Outside a git repo, <Rostr /> uses your default.
      </dd>
    </dl>
  </section>

  {COMMAND_GROUPS.map((group) => (
    <>
      <section class="group-header" id={group.id}>
        <h2><span aria-hidden="true">{group.emoji}</span> {group.title}</h2>
        <p>{group.lede}</p>
      </section>
      {group.commands.map((command) => (
        <section class="section command-doc" id={command.id}>
          <div class="command-heading">
            <h3><code>rostr {command.heading ?? command.id}</code></h3>
            {command.badge && <span class="command-badge-pill">{command.badge}</span>}
          </div>
          <div class="usage"><Code code={command.usage} lang="text" frame="none" wrap /></div>
          <p>{command.summary}</p>
          {command.note && <p class="command-note">💡 {command.note}</p>}
          {command.options && (
            <dl class="options">
              {command.options.map((option) => (
                <div class="option-row">
                  <dt><code>{option.flag}</code></dt>
                  <dd>{option.description}</dd>
                </div>
              ))}
            </dl>
          )}
          <Code code={toTerminalText(command.example)} lang="ansi" frame="terminal" />
        </section>
      ))}
      {group.id === "agent-commands" && (
        <section class="section" id="slash-commands">
          <div class="command-heading">
            <h3>Slash command</h3>
          </div>
          <p>
            If you'd rather draft by hand, turn auto-draft off and use this in Claude Code. <code>rostr assemble</code> installs it.
          </p>
          <dl class="options">
            <div class="option-row">
              <dt><code>/draft</code></dt>
              <dd>Draft an agent for this session. Runs <code>rostr draft</code>.</dd>
            </div>
          </dl>
        </section>
      )}
    </>
  ))}
</Layout>

<style>
  .docs-hero {
    padding: 72px 0 40px;
  }

  .docs-hero h1 {
    font-size: clamp(36px, 6vw, 52px);
    margin: 0 0 16px;
  }

  /* Quick links: a group label, then that group's commands, which wrap within their own column */
  .toc {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: start;
    gap: 8px;
    margin-bottom: 12px;
  }

  .toc .toc-group {
    padding-top: 5px;
    font-weight: 700;
    font-size: 15px;
  }

  .toc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .toc {
      grid-template-columns: 1fr;
    }
  }

  .toc a {
    text-decoration: none;
  }

  .toc code {
    color: var(--text);
    font-weight: 400;
    display: inline-block;
    padding: 4px 10px;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .toc a:hover code {
    border-color: var(--accent);
  }

  .concepts dt {
    font-weight: 700;
    margin-top: 16px;
  }

  .concepts dd {
    margin: 4px 0 0;
    color: var(--muted);
    max-width: 40em;
  }

  /* Optional pill next to a command's heading, e.g. for commands the hooks run */
  .command-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 16px;
  }

  .command-heading h3 {
    margin: 0;
    font-size: 28px;
  }

  .command-badge-pill {
    margin-left: auto;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
  }

  .command-note {
    padding: 14px 18px;
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* Header that starts each command group: a heavier rule and larger title than the command sections under it.
     The section above already ends with 56px of padding, so the header adds no top margin of its own. */
  .group-header {
    padding-top: 40px;
    border-top: 2px solid var(--text);
  }

  .group-header h2 {
    margin: 0 0 8px;
    font-size: 36px;
  }

  .group-header p {
    margin: 0;
    max-width: 40em;
    color: var(--muted);
    font-size: 18px;
  }

  /* The group header already separates groups, so the first command under it sits closer and has no divider line */
  .group-header + .command-doc {
    padding-top: 40px;
    border-top: none;
  }

  .command-doc h3 code {
    color: var(--text);
    background: none;
    padding: 0;
    font-size: 0.9em;
  }

  .command-doc p {
    max-width: 40em;
  }

  .usage {
    margin-bottom: 16px;
  }

  .options {
    margin: 0 0 20px;
  }

  .option-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .option-row dt code {
    background: none;
    padding: 0;
    font-weight: 600;
  }

  .option-row dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .option-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
