---
import { CLOUDFLARE_ANALYTICS_TOKEN, GITHUB_URL, X_HANDLE, X_URL } from "../consts";
import GitHubIcon from "../assets/github.svg";
import Logo from "../assets/logo.svg";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// The link preview image, shared by every page; see public/og.png
const previewImageUrl = new URL("/og.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Link previews (Open Graph, then X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rostr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An orange name tag that reads &quot;Gandalf&quot; with a wizard emoji, next to &quot;is fixing CI.&quot;" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={X_HANDLE} />

    <!-- Cloudflare Web Analytics: cookieless, and counted only on getrostr.sh, not on local or preview builds -->
    {CLOUDFLARE_ANALYTICS_TOKEN && (
      <script is:inline define:vars={{ token: CLOUDFLARE_ANALYTICS_TOKEN }}>
        if (location.hostname === "getrostr.sh") {
          const beacon = document.createElement("script");
          beacon.defer = true;
          beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
          beacon.dataset.cfBeacon = JSON.stringify({ token });
          document.head.appendChild(beacon);
        }
      </script>
    )}
  </head>
  <body>
    <header class="nav">
      <a class="wordmark" href="/"><Logo class="wordmark-logo" aria-hidden="true" />rostr</a>
      <nav>
        <a href="/#how-it-works">How it works</a>
        <a href="/cli">CLI</a>
        <a href="/#install">Install</a>
        <a class="nav-icon" href={GITHUB_URL} aria-label="GitHub"><GitHubIcon aria-hidden="true" /></a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <a class="wordmark footer-wordmark" href="/"><Logo class="wordmark-logo" aria-hidden="true" />rostr</a>
      <nav class="footer-links" aria-label="Footer">
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href={GITHUB_URL}>GitHub</a>
        <a href={X_URL}>X</a>
      </nav>
      <p class="footer-credit">
        Made with ❤️ in Tokyo by <a href={X_URL}>Michael Piazza</a>{" "}
        <span class="footer-separator">·</span>{" "}
        <span class="footer-copyright">© {new Date().getFullYear()} Rosebud Labs</span>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --surface: #ffffff;
    --text: #1c1b19;
    --muted: #6b675f;
    --border: #e6e2da;
    --accent: #d9480f;
    --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141312;
      --surface: #1c1b19;
      --text: #ece8df;
      --muted: #9c978d;
      --border: #2e2c29;
      --accent: #ff7a3d;
    }
  }

  * {
    box-sizing: border-box;
  }

  /* Stop iOS Safari from enlarging small text on its own, which pushes text like the number circles out of their boxes */
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    overflow-x: clip; /* the hero's full-bleed background is 100vw wide, which counts the scrollbar */
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  /* Inline commands stand out in the accent color */
  code {
    font-family: var(--mono);
    font-size: 0.88em;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  /* An example session title, styled as plain UI text rather than a command */
  .session-title {
    padding: 0.1em 0.45em;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Code inside terminal windows keeps the terminal's own colors */
  .expressive-code code {
    font-weight: inherit;
    color: inherit;
    background: none;
    padding: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .nav,
  main,
  .footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Above the hero's background, which extends up behind it */
  .nav {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }

  .wordmark-logo {
    width: 24px;
    height: auto;
  }

  /* "rostr" in running text: the wordmark's monospace and weight, in full-strength text color even inside gray copy */
  .brand-name {
    font-family: var(--mono);
    font-size: 0.92em;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .nav nav {
    display: flex;
    gap: 20px;
    font-size: 15px;
  }

  .nav nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--text);
  }

  .nav nav {
    align-items: center;
  }

  .nav-icon svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Hero */
  /* Extra bottom padding leaves room for the Slack notification hanging off the bottom of the hero terminal */
  .hero {
    position: relative;
    isolation: isolate;
    padding: 72px 0 80px;
  }

  .hero h1 {
    font-size: clamp(40px, 9vw, 84px);
    line-height: 1.05;
    margin: 0 0 12px;
  }

  /* The hero's status, a flipping agent name and what it's on, follows "Remember who's doing what." on the same line.
     It's set in monospace, a little smaller, like a status readout, with the task in gray. On phones it gets its own
     line, and the task another. */
  .hero-status {
    font-family: var(--mono);
    font-size: 0.8em;
    letter-spacing: -0.02em;
    /* A monospace space is a full character wide; tighten the gaps between words */
    word-spacing: -0.25em;
    white-space: nowrap;
  }

  .hero-status-task {
    color: var(--muted);
    font-weight: 500;
  }

  .status-emoji {
    margin-right: 0.3em;
  }

  .hero-status {
    margin-left: 0.3em;
  }

  .task-text {
    display: inline-block;
  }

  .task-text.is-swapping {
    animation: task-in 0.12s ease-out;
  }

  @keyframes task-in {
    from {
      opacity: 0;
      transform: translateY(0.15em);
    }
  }

  /* The flipping name. The script sizes it to the current name, easing between widths so " is on" follows along.
     It's taller than the line, with matching negative margins, so the landing overshoot isn't clipped. An invisible
     in-flow character gives it a baseline level with the names, so it lines up with the text around it. */
  .name-flipper {
    position: relative;
    display: inline-block;
    transition: width 0.2s ease;
    height: 1.5em;
    padding-top: 0.2em;
    margin: -0.2em 0 -0.45em;
    clip-path: inset(0 -100vw);
    color: var(--accent);
    white-space: nowrap;
  }

  .name-flipper::before {
    content: "\200b";
  }

  .name-flipper > span {
    position: absolute;
    top: 0.2em;
    left: 0;
  }

  /* A name on its own, like the first one before the script runs, stays in the flow so the slot fits it */
  .name-flipper > span:only-child {
    position: static;
  }

  /* The landing is a light spring (damping ratio 0.55, sampled into linear()): it overshoots by about an eighth of a
     line and settles in one quick bounce */
  .name-flipper .is-entering {
    animation: name-in 0.45s
      linear(0, 0.034, 0.122, 0.244, 0.383, 0.526, 0.662, 0.785, 0.889, 0.974, 1.038, 1.083, 1.111, 1.124, 1.126, 1.119,
        1.106, 1.09, 1.072, 1.054, 1.038, 1.023, 1.01, 1, 0.993, 0.988, 0.985, 0.984, 0.984, 0.985, 0.987, 0.989, 0.992,
        0.994, 0.996, 0.998, 1)
      both;
  }

  .name-flipper .is-leaving {
    animation: name-out 0.16s ease-in both;
  }

  @keyframes name-in {
    from {
      transform: translateY(110%);
      opacity: 0;
    }
  }

  @keyframes name-out {
    to {
      transform: translateY(-110%);
      opacity: 0;
    }
  }

  .hero-subtitle {
    font-size: clamp(26px, 3.2vw, 32px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 24px;
  }

  /* On phones the title fills the width in two lines, "Remember who's doing what." fits on one, and the status gets
     a line of its own. The sizes scale with the screen: the divisors are each line's width in ems. */
  @media (max-width: 640px) {
    .hero h1 {
      font-size: calc((100vw - 48px) / 7.3);
    }

    .hero-subtitle {
      font-size: calc((100vw - 48px) / 14.3);
    }

    .hero-status {
      display: block;
      margin: 6px 0 0;
    }
  }

  .lede {
    font-size: 20px;
    color: var(--muted);
    max-width: 36em;
    margin: 0 0 32px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    padding: 12px 16px;
    font: 14px var(--mono);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
  }

  .copy:hover {
    border-color: var(--accent);
  }

  .copy-label {
    flex-shrink: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .copy-block {
    width: 100%;
    justify-content: space-between;
  }

  .cta-title {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .cta-alt {
    display: inline-block;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }

  .cta-alt:hover {
    color: var(--text);
  }

  /* The live bar: pinned to the bottom of the screen and sliding up once the visitor scrolls down, with "LIVE · X agents
     drafted out of Y" crawling slowly across it. Six copies, so the crawl never runs out; the track moves by half
     (three copies) per loop. */
  .live-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    overflow: hidden;
    padding-bottom: env(safe-area-inset-bottom);
    background: #1c1b19;
    color: #ece8df;
    font-family: var(--mono);
    font-size: 13px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transform: translateY(110%);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .live-bar.is-shown {
    transform: none;
  }

  .live-bar-track {
    display: inline-flex;
    padding: 10px 0;
    animation: live-bar 75s linear infinite;
  }

  .live-bar-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-right: max(240px, 35vw);
  }

  .live-bar-badge {
    padding: 1px 8px;
    border-radius: 4px;
    background: #e03131;
    color: #fff;
    font-weight: 800;
  }

  .live-bar b {
    color: #ff7a3d;
    font-weight: 800;
  }

  @keyframes live-bar {
    to {
      transform: translateX(-50%);
    }
  }

  /* The hero's install prompt: the old layout, with an accent outline, small hard shadow, and a filled Copy button */
  .copy-hero {
    padding: 8px 8px 8px 16px;
    border: 1.5px solid var(--accent);
    box-shadow: 3px 3px 0 var(--accent);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .copy-hero:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--accent);
  }

  .copy-hero:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--accent);
  }

  .copy-hero .copy-label {
    padding: 6px 14px;
    border-radius: 7px;
    background: var(--accent);
    color: white;
    font-family: var(--sans);
    font-weight: 700;
  }

  /* The hero's terminal, with notifications from its agents over it: Claude's over the top-right corner on load, and
     Slack's over the bottom-left once the visitor scrolls a little. Both bob gently once they've landed. */
  .hero-terminal {
    position: relative;
    margin-top: 64px;
  }

  /* On load, the hero's text fades up line by line, then the terminal, then Claude's notification slides in */
  .hero > :is(h1, .hero-subtitle, .lede, .cta-title, .cta, .cta-alt) {
    --rise: 12px;
    animation: rise-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero > .hero-subtitle {
    animation-delay: 70ms;
  }

  .hero > .lede {
    animation-delay: 140ms;
  }

  .hero > .cta-title {
    animation-delay: 210ms;
  }

  .hero > .cta {
    animation-delay: 280ms;
  }

  .hero > .cta-alt {
    animation-delay: 350ms;
  }

  .hero-terminal > .expressive-code {
    --rise: 24px;
    animation: rise-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s both;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(var(--rise));
    }
  }

  .hero-notification {
    z-index: 1;
  }

  .hero-notification-claude {
    animation:
      notification-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15) 1.3s both,
      notification-float 3.2s ease-in-out 1.8s infinite;
  }

  .hero-notification-slack {
    position: absolute;
    left: -16px;
    bottom: -28px;
    width: min(92%, 330px);
    visibility: hidden;
  }

  .hero-notification-slack.is-shown {
    visibility: visible;
    animation:
      notification-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15) both,
      notification-float 3.6s ease-in-out 0.5s infinite;
  }

  .notification-icon.notification-icon-slack {
    background: #4a154b;
    font-size: 20px;
    font-weight: 800;
  }

  @keyframes notification-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-notification,
    .hero > :is(h1, .hero-subtitle, .lede, .cta-title, .cta, .cta-alt),
    .hero-terminal > .expressive-code,
    .live-bar-track {
      animation: none !important;
    }
  }

  /* Uses translate, not transform, so it doesn't fight the slide-in */
  @keyframes notification-float {
    50% {
      translate: 0 -5px;
    }
  }

  /* Sections */
  .section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  /* Every section ends at its padding, whatever its last block's own margin */
  .section > :last-child,
  .section > :last-child > li:last-child {
    margin-bottom: 0;
  }

  /* A sub-section's label, written as the command that shows what follows, like "$ rostr --help" over the command
     groups */
  .subhead-command {
    margin: 48px 0 16px;
    font: 600 15px var(--mono);
  }

  .subhead-command span {
    margin-right: 10px;
    color: var(--accent);
  }

  .section h2 {
    font-size: 32px;
    margin: 0 0 16px;
  }

  .narrow p {
    max-width: 38em;
  }

  .section-lede {
    color: var(--muted);
    max-width: 38em;
    margin: 0 0 32px;
  }

  /* Privacy policy and terms of service, rendered from Markdown */
  .legal {
    max-width: 44em;
    padding: 72px 0 56px;
  }

  .legal h1 {
    font-size: clamp(36px, 6vw, 52px);
    margin: 0 0 8px;
  }

  .legal h2 {
    font-size: 22px;
    margin: 40px 0 12px;
  }

  .legal table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .legal th,
  .legal td {
    padding: 10px 8px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin: 0 0 32px;
  }

  .steps li {
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
  }

  .steps h3 {
    margin: 12px 0 6px;
    font-size: 19px;
  }

  .steps p {
    margin: 0;
    color: var(--muted);
  }

  /* On phones the steps stack, so each number sits beside its heading, like the reasons list */
  @media (max-width: 640px) {
    .steps li {
      display: grid;
      grid-template-columns: 28px 1fr;
      column-gap: 14px;
    }

    .steps li::before {
      grid-row: span 2;
    }

    .steps h3 {
      margin-top: 3px;
    }
  }


  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }

  .card h3 {
    margin: 0 0 8px;
    font-size: 19px;
  }

  .card p {
    margin: 0 0 16px;
    color: var(--muted);
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  /* "Why anthropomorphize" section: a narrow numbered list, with orange number circles (like "How it works") in a gutter */
  .value-list {
    list-style: none;
    counter-reset: reason;
    display: grid;
    gap: 24px;
    max-width: 38em;
    margin: 28px 0 0;
    padding: 0;
  }

  .value-list li {
    counter-increment: reason;
    display: grid;
    grid-template-columns: 24px 1fr;
    column-gap: 14px;
  }

  /* The circle is centered on the heading's first line */
  .value-list li::before {
    content: counter(reason);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }

  .value-list h3 {
    margin: 1px 0 4px;
    font-size: 19px;
  }

  .value-list p {
    margin: 0;
    color: var(--muted);
  }

  /* Lines up with the reasons' text, past the number gutter (24px circle + 14px gap) */
  .value-closer {
    margin: 32px 0 0 38px;
    font-size: 19px;
  }

  /* The notification sits over the top-right corner of the terminal, like a real macOS banner */
  .scene-notification {
    position: absolute;
    top: -34px;
    right: -12px;
    width: min(92%, 330px);
  }

  .scene-notification.is-waiting {
    box-shadow: 0 0 0 2px #d9480f, 0 8px 24px -12px rgb(0 0 0 / 0.5);
  }

  @media (max-width: 640px) {
    .scene-notification {
      right: -6px;
    }
  }


  .notification {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 14px;
    background: #f6f6f6;
    color: #1c1b19;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.5);
  }

  .notification-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #d97757;
    color: white;
  }

  .notification-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .notification-text {
    min-width: 0;
    flex: 1;
  }

  .notification-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 13.5px;
  }

  .notification-top strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notification-top span {
    flex-shrink: 0;
    color: #6b675f;
    font-size: 12px;
  }

  .notification-text p {
    margin: 0;
    color: #3d3a35;
    font-size: 13px;
    line-height: 1.4;
  }

  /* Example dashboard in the "Build on it" section: something a user built, so it has its own look (flat, pale
     lavender with purple accents) in fixed colors, like a screenshot, the same in both themes */
  .dashboard {
    --dash-bg: #f2efff;
