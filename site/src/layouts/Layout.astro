---
import { GITHUB_URL, X_URL } from "../consts";
import GitHubIcon from "../assets/github.svg";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="nav">
      <a class="wordmark" href="/">rostr</a>
      <nav>
        <a href="/#how-it-works">How it works</a>
        <a href="/cli">CLI docs</a>
        <a href="/#install">Install</a>
        <a class="nav-icon" href={GITHUB_URL} aria-label="GitHub"><GitHubIcon aria-hidden="true" /></a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <span>Made with ❤️ in Tokyo by <a href={X_URL}>Michael Piazza</a> · © {new Date().getFullYear()} Rosebud Labs</span>
      <span class="footer-links">
        <a href="/privacy">Privacy</a>
        <a href={GITHUB_URL}>GitHub</a>
        <a href={X_URL}>X</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --surface: #ffffff;
    --text: #1c1b19;
    --muted: #6b675f;
    --border: #e6e2da;
    --accent: #d9480f;
    --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141312;
      --surface: #1c1b19;
      --text: #ece8df;
      --muted: #9c978d;
      --border: #2e2c29;
      --accent: #ff7a3d;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  /* Inline commands stand out in the accent color */
  code {
    font-family: var(--mono);
    font-size: 0.88em;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  /* An example session title, styled as plain UI text rather than a command */
  .session-title {
    padding: 0.1em 0.45em;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Code inside terminal windows keeps the terminal's own colors */
  .expressive-code code {
    font-weight: inherit;
    color: inherit;
    background: none;
    padding: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .nav,
  main,
  .footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
  }

  .wordmark {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }

  .nav nav {
    display: flex;
    gap: 20px;
    font-size: 15px;
  }

  .nav nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--text);
  }

  .nav nav {
    align-items: center;
  }

  .nav-icon svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Hero */
  .hero {
    padding: 72px 0 48px;
  }

  .hero h1 {
    font-size: clamp(36px, 6vw, 60px);
    max-width: 14em;
    margin: 0 0 20px;
  }

  .lede {
    font-size: 20px;
    color: var(--muted);
    max-width: 36em;
    margin: 0 0 32px;
  }

  .lede-example {
    color: var(--text);
    font-size: 22px;
    margin-bottom: 12px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    padding: 12px 16px;
    font: 14px var(--mono);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
  }

  .copy:hover {
    border-color: var(--accent);
  }

  .copy-label {
    flex-shrink: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .copy-block {
    width: 100%;
    justify-content: space-between;
  }

  .button-secondary {
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  }

  .cta-title {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .cta-alt {
    display: inline-block;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }

  .cta-alt:hover {
    color: var(--text);
  }

  /* The hero's install prompt: the old layout, with an accent outline, small hard shadow, and a filled Copy button */
  .copy-hero {
    padding: 8px 8px 8px 16px;
    border: 1.5px solid var(--accent);
    box-shadow: 3px 3px 0 var(--accent);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .copy-hero:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--accent);
  }

  .copy-hero:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--accent);
  }

  .copy-hero .copy-label {
    padding: 6px 14px;
    border-radius: 7px;
    background: var(--accent);
    color: white;
    font-family: var(--sans);
    font-weight: 700;
  }

  .works-with {
    color: var(--muted);
    font-size: 15px;
    margin: 16px 0 48px;
  }

  /* Sections */
  .section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  .section h2 {
    font-size: 32px;
    margin: 0 0 16px;
  }

  .narrow p {
    max-width: 38em;
  }

  .section-lede {
    color: var(--muted);
    max-width: 38em;
    margin: 0 0 32px;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin: 0 0 32px;
  }

  .steps li {
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 14px;
  }

  .steps h3 {
    margin: 12px 0 6px;
    font-size: 19px;
  }

  .steps p {
    margin: 0;
    color: var(--muted);
  }


  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }

  .card h3 {
    margin: 0 0 8px;
    font-size: 19px;
  }

  .card p {
    margin: 0 0 16px;
    color: var(--muted);
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  /* "Poor human brain" section: benefit cards */
  .value-grid h3 {
    margin: 0 0 6px;
    font-size: 21px;
  }


  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }

  .value-closer {
    margin: 28px 0 0;
    font-size: 19px;
    font-weight: 600;
  }

  /* A chat message signed by an agent, in fixed light colors like a screenshot */
  .chat-message {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid #ebe8e2;
    border-radius: 10px;
    background: #ffffff;
    color: #1c1b19;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #f1ede6;
    font-size: 20px;
  }

  .chat-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
  }

  .chat-meta span {
    color: #8a857b;
    font-size: 12px;
  }

  .chat-message p {
    margin: 2px 0 0 !important;
    color: #1c1b19 !important;
    font-size: 14px;
  }

  /* Before/after mockup in the "poor human brain" section: an app window with a session sidebar and a notification.
     The mockup uses fixed light colors, like a screenshot, so it looks the same in both themes. */
  .notification-compare {
    margin: 8px 0 24px;
    padding: 56px 48px 40px;
    border-radius: 16px;
    background: linear-gradient(135deg, #5b7fd6, #9b6cc9 55%, #e0866b);
  }


  .app-window {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    border-radius: 12px;
    background: #ffffff;
    color: #1c1b19;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.5);
  }

  .app-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid #ebe8e2;
  }

  .app-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #dcd8d0;
  }

  .app-body {
    display: grid;
    grid-template-columns: 62% 1fr;
    min-height: 210px;
  }

  .app-sidebar {
    list-style: none;
    margin: 0;
    padding: 10px 8px;
    border-right: 1px solid #ebe8e2;
    background: #f6f4ef;
    border-radius: 0 0 0 12px;
  }

  .app-sidebar li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 8px;
    border-radius: 7px;
    font-size: 13px;
    color: #4a4740;
  }

  .session-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The session the notification is about */
  .app-sidebar li.is-waiting {
    background: color-mix(in srgb, #d9480f 12%, white);
    box-shadow: inset 0 0 0 1.5px #d9480f;
    color: #1c1b19;
    font-weight: 600;
  }

  .waiting-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-left: auto;
    border-radius: 50%;
    background: #d9480f;
  }

  .app-main {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 14px;
  }

  .app-main span {
    height: 8px;
    border-radius: 4px;
    background: #ebe8e2;
  }

  .app-main span:nth-child(2) {
    width: 70%;
  }

  .app-main span:nth-child(4) {
    width: 50%;
  }

  /* The notification sits over the top-right corner of the window, like a real macOS banner */
  .scene-notification {
    position: absolute;
    top: -34px;
    right: -12px;
    width: min(92%, 330px);
  }

  .scene-notification.is-waiting {
    box-shadow: 0 0 0 2px #d9480f, 0 8px 24px -12px rgb(0 0 0 / 0.5);
  }

  @media (max-width: 640px) {
    .notification-compare {
      padding: 52px 16px 24px;
    }

    .scene-notification {
      right: -6px;
    }
  }


  .notification {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 14px;
    background: #f6f6f6;
    color: #1c1b19;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.5);
  }

  .notification-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #d97757;
    color: white;
  }

  .notification-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .notification-text {
    min-width: 0;
    flex: 1;
  }

  .notification-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 13.5px;
  }

  .notification-top strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notification-top span {
    flex-shrink: 0;
    color: #6b675f;
    font-size: 12px;
  }

  .notification-text p {
    margin: 0;
    color: #3d3a35;
    font-size: 13px;
    line-height: 1.4;
  }

  /* Fake dashboard in the "Build on it" section */
  .dashboard {
    margin: 0 0 32px;
    background: var(--surface);
    border: 2px solid var(--text);
    border-radius: 14px;
    box-shadow: 5px 5px 0 var(--text);
    overflow: hidden;
  }

  .dashboard-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 2px solid var(--text);
    background: var(--bg);
  }

  .dashboard-bar > span:not(.dashboard-url) {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .dashboard-url {
    margin-left: 12px;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: 12px var(--mono);
  }

  .dashboard-body {
    padding: 20px;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .dashboard-header strong {
    font-size: 20px;
  }

  .dashboard-header span {
    color: var(--muted);
    font-size: 14px;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
  }

  .agent-card {
    padding: 14px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
  }

  .agent-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .agent-emoji {
    font-size: 22px;
  }

  .status-dot {
    width: 9px;
    height: 9px;
    margin-left: auto;
    border-radius: 50%;
    background: #2f9e44;
    box-shadow: 0 0 0 3px color-mix(in srgb, #2f9e44 25%, transparent);
  }

  .agent-task {
    margin: 10px 0 12px;
    font-size: 15px;
    line-height: 1.4;
  }

  .agent-meta {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font: 12px var(--mono);
  }

  .dashboard-bench {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
  }

  .dashboard-bench .chip {
    animation: none;
  }

  .bench-label {
    margin-right: 6px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  .dashboard figcaption {
    padding: 10px 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }

  /* Headings sit a little further from the code blocks, whose shadows make 8px look cramped */
  .build-cards h3 {
    margin-bottom: 12px;
  }

  .build-cards .build-subhead {
    margin-top: 28px;
  }

  /* A slightly smaller code font so the curl example and JSON fit side by side in half-width cards */
  .build-cards .expressive-code {
    --ec-codeFontSize: 13px;
    --ec-codePadInl: 16px;
  }

  /* A text-style button that copies a prompt, like the decryption prompt in "Build on it" */
  .copy-link {
    display: block;
    padding: 0;
    font: inherit;
    font-size: 15px;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .copy-link:hover .copy-label {
    text-decoration: underline;
  }

  .build-note code {
    white-space: nowrap;
  }

  .build-note {
    margin: 12px 0 16px !important;
    font-size: 15px;
  }

  .build-note:last-child {
    margin-bottom: 0 !important;
  }

  .accent-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  /* Command group cards on the home page, each linking to its group in the CLI docs */
  .group-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .group-card {
    display: block;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .group-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .group-card-commands {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Local and cloud: two short labeled lines instead of cards, so the section scans quickly */
  .modes {
    display: grid;
    gap: 12px;
    margin: 0 0 20px;
    max-width: 44em;
  }

  .modes div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  .modes dt {
    font-weight: 700;
  }

  .modes dd {
    margin: 0;
    color: var(--muted);
  }

  .modes-note {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .modes div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .threads {
    margin: 0;
    padding-left: 22px;
    max-width: 40em;
  }

  .threads li {
    margin-bottom: 14px;
    padding-left: 4px;
  }

  .docs-link {
    margin: 20px 0 0;
    font-weight: 600;
  }

  .docs-link a {
    color: var(--accent);
    text-decoration: none;
  }

  .rosters {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }

  .rosters li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 14px;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  /* Alternate the tilt direction from one roster to the next */
  .rosters li:nth-child(odd) {
    --tilt: 1;
  }

  .rosters li:nth-child(even) {
    --tilt: -1;
  }

  .rosters li:hover,
  .rosters li:focus-visible {
    z-index: 5;
    border-color: var(--text);
    box-shadow: 3px 3px 0 var(--text);
    transform: translate(-2px, -2px) rotate(calc(var(--tilt) * -1deg));
    outline: none;
  }

  .rosters li:hover .roster-emoji,
  .rosters li:focus-visible .roster-emoji {
    animation: wiggle 0.5s ease;
  }

  /* A featured roster (Free Agents): accent outline and tint, a corner tag, and an emoji that rolls on hover */
  .rosters li.roster-featured {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  }

  .roster-tag {
    position: absolute;
    top: -9px;
    right: 12px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rosters li.roster-featured:hover .roster-emoji,
  .rosters li.roster-featured:focus-visible .roster-emoji {
    animation: roll 0.6s ease;
  }

  @keyframes roll {
    to {
      transform: rotate(360deg) scale(1.1);
    }
  }

  /* A team / B team popover, shown on hover or keyboard focus. It opens up and to the right, overlapping the top of
     the tile; the script below nudges it left when it would run off the screen. */
  .roster-teams {
    display: none;
    position: absolute;
    bottom: 78%;
    left: 50%;
    width: min(340px, calc(100vw - 32px));
    padding: 12px;
    background: var(--surface);
    border: 2px solid var(--text);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--text);
    transform: rotate(calc(var(--tilt) * 1.5deg));
    transform-origin: bottom left;
  }

  .rosters li:hover .roster-teams,
  .rosters li:focus-within .roster-teams {
    display: block;
    animation: pop-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .roster-teams b {
    display: block;
    margin: 0 0 6px;
    color: var(--accent);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* The B team label and chips are gray, so the A team stands out */
  .chips + b {
    margin-top: 10px;
    color: var(--muted);
  }

  .roster-teams .chip:not(.chip-a) {
